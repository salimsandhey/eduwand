{
  "expo": {
    "name": "EduWand",
    "slug": "eduwand",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/eduwand-icon.png",
    "assetBundlePatterns": [
      "assets/fonts/*",
      "assets/brand/*",
      "assets/decorative/*",
      "assets/avatars/*",
      "assets/icons/*"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1E8",
        "foregroundImage": "./assets/brand/eduwand-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.eduwand.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/brand/eduwand-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "74df1a69-be7b-4ab8-a55e-d12357e211a8"
      }
    },
    "owner": "salimsandhey",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/eduwand-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Poppins-Regular.ttf",
            "./assets/fonts/Poppins-Medium.ttf",
            "./assets/fonts/Poppins-SemiBold.ttf",
            "./assets/fonts/Poppins-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Poppins-Regular",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Poppins-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Poppins-Medium",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Poppins-Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Poppins-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Poppins-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Poppins-Bold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Poppins-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach a profile photo to a lead from your photo library.",
          "cameraPermission": "Used to take a profile photo of a lead directly in the app."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-sharing",
      "expo-web-browser"
    ]
  }
}
