{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.eduwand.com/api/v1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.eduwand.com/api/v1",
        "EXPO_PUBLIC_ADMIN_URL": "https://admin.eduwand.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6812983162"
      }
    }
  }
}
