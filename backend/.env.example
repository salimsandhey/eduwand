DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduwand?schema=public"
PORT=4000
# Use a random value of at least 32 characters (e.g. `openssl rand -base64 48`). The server refuses to start in production with a weak one.
JWT_SECRET="change-me-in-every-environment"
# Claude on AWS Bedrock - runs all writing, grading, OCR and the assistant. Create a Bedrock API key in the AWS console.
AWS_REGION="ap-south-1"
AWS_BEARER_TOKEN_BEDROCK="your-bedrock-api-key"
# Optional overrides (defaults are the global Sonnet 4.6 / Haiku 4.5 inference profiles).
# BEDROCK_SONNET_MODEL_ID="global.anthropic.claude-sonnet-4-6"
# BEDROCK_HAIKU_MODEL_ID="global.anthropic.claude-haiku-4-5-20251001-v1:0"
# Gemini is used ONLY for web research (Google Search grounding).
# Spend guard: server-side ceilings that hold even if every limit in the admin panel is turned off (USD).
# AI_HARD_MAX_USD_PER_DAY=20
# AI_HARD_MAX_USD_PER_MONTH=200
GEMINI_API_KEY="your-gemini-api-key"
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
FROM_EMAIL="noreply@your-verified-domain.com"
# Optional: link behind the "Open EduWand" button in emails (store page or universal link). Buttons are omitted when unset.
APP_URL=""

# --- Security ---
# Browser origins allowed to call the API, comma-separated (the admin dashboard). Required in production; mobile apps are unaffected.
CORS_ORIGINS="https://admin.your-domain.com"
# Set to true (or a proxy hop count) when running behind a load balancer/reverse proxy so IP-based rate limits see the real client IP.
TRUST_PROXY=false
# LOCAL DEVELOPMENT ONLY: makes every login/sign-up code 123456 and echoes it in API responses. The server refuses to start with this set in production.
ALLOW_DEV_OTP=false

# --- Payments (individual teacher plans, bought on the website) ---
# Razorpay keys from the dashboard (start with the rzp_test_ pair). The webhook secret is the one you set when
# creating the webhook (URL: <api>/api/v1/billing/webhook, events: payment.captured, order.paid, payment.failed).
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# LOCAL DEVELOPMENT ONLY: a fake gateway so the purchase flow can be tried without Razorpay. Refused in production.
# RAZORPAY_MOCK=false
# The website page where a teacher signs in to manage their plan - linked from the plan-ending emails only (never from the mobile app).
# BILLING_URL="https://admin.your-domain.com/billing"
