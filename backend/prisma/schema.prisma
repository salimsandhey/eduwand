// EduWand backend — Prisma schema
// Models are added module by module. This file currently covers only the
// Platform and Tenancy tables (Docs/Dev/EduWand_Database_Schema.md, section 2).
// Enrolment Growth Engine and AI Module tables are added in later steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trust {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactEmail String?  @map("contact_email")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid

  schools School[]

  @@map("trust")
}

model School {
  id           String   @id @default(uuid()) @db.Uuid
  trustId      String   @map("trust_id") @db.Uuid
  trust        Trust    @relation(fields: [trustId], references: [id])
  name         String
  board        String
  address      String?
  timezone     String   @default("Asia/Kolkata")
  incumbentErp String?  @map("incumbent_erp")
  status       String   @default("onboarding")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid

  academicYears     AcademicYear[]
  users             AppUser[]
  userSchoolAccess  UserSchoolAccess[]
  enquiries         Enquiry[]
  studentStubs      StudentStub[]
  csvExportLogs     CsvExportLog[]
  pipelineStages    PipelineStage[]
  csvExportSchedule CsvExportSchedule?
  lessonPlans       LessonPlan[]
  researchReports   ResearchReport[]
  assignments       Assignment[]
  aiUsageLogs       AiUsageLog[]

  @@map("school")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  label     String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  classSections ClassSection[]

  @@map("academic_year")
}

model ClassSection {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  className      String       @map("class_name")
  sectionName    String       @map("section_name")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  studentStubs StudentStub[]
  lessonPlans  LessonPlan[]
  assignments  Assignment[]

  @@map("class_section")
}

// Role is one of: front_desk, counsellor, teacher, admin, leadership
// (kept as free text to match the reference schema; enforce the allowed set in application code)
model AppUser {
  id             String   @id @default(uuid()) @db.Uuid
  trustId        String?  @map("trust_id") @db.Uuid
  schoolId       String?  @map("school_id") @db.Uuid
  school         School?  @relation(fields: [schoolId], references: [id])
  fullName       String   @map("full_name")
  email          String   @unique
  phone          String?
  role           String
  authProviderId String?  @map("auth_provider_id")
  passwordHash   String?  @map("password_hash")
  status         String   @default("invited")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  schoolAccess        UserSchoolAccess[]
  ownedEnquiries      Enquiry[]             @relation("EnquiryOwner")
  enquiryStageChanges EnquiryStageHistory[]
  enquiryNotes        EnquiryNote[]
  assignedFollowUps   FollowUpTask[]
  csvExportLogs       CsvExportLog[]
  uploadedDocuments   Document[]
  lessonPlans         LessonPlan[]
  researchReports     ResearchReport[]
  assignments         Assignment[]
  personalisationDecisions PersonalisationSuggestion[]
  gradeOverrides      Grade[]
  aiUsageLogs         AiUsageLog[]

  @@map("app_user")
}

// Maps a user to multiple schools within a trust, for staff assigned across more than one school
model UserSchoolAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      AppUser  @relation(fields: [userId], references: [id])
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, schoolId])
  @@map("user_school_access")
}

// Status is one of: new, contacted, visit, application, admitted, enrolled, lost
// Source is one of: phone, walk_in, website, referral, event, social
model Enquiry {
  id                   String    @id @default(uuid()) @db.Uuid
  schoolId             String    @map("school_id") @db.Uuid
  school               School    @relation(fields: [schoolId], references: [id])
  contactName          String    @map("contact_name")
  contactPhone         String    @map("contact_phone")
  contactEmail         String?   @map("contact_email")
  source               String
  gradeInterest        String?   @map("grade_interest")
  status               String    @default("new")
  lostReason           String?   @map("lost_reason")
  ownerUserId          String?   @map("owner_user_id") @db.Uuid
  owner                AppUser?  @relation("EnquiryOwner", fields: [ownerUserId], references: [id])
  duplicateOfEnquiryId String?   @map("duplicate_of_enquiry_id") @db.Uuid
  duplicateOf          Enquiry?  @relation("EnquiryDuplicate", fields: [duplicateOfEnquiryId], references: [id])
  duplicates           Enquiry[] @relation("EnquiryDuplicate")
  consentCaptured      Boolean   @default(false) @map("consent_captured")
  erasedAt             DateTime? @map("erased_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            String?   @map("created_by") @db.Uuid
  updatedBy            String?   @map("updated_by") @db.Uuid

  stageHistory  EnquiryStageHistory[]
  notes         EnquiryNote[]
  followUpTasks FollowUpTask[]
  studentStub   StudentStub?
  documents     Document[]

  @@index([schoolId, status])
  @@index([schoolId, contactPhone])
  @@map("enquiry")
}

// Configurable admissions pipeline (FR-EG-3): stages are per-school, not a fixed
// enum. is_terminal marks a non-sequential outcome (e.g. "lost"), is_converted
// marks a stage that counts toward the conversion rate (e.g. admitted/enrolled).
// New schools are seeded with the same 7 default stages this replaces
// (see lib/pipeline-stages.ts) so existing behavior is unchanged out of the box.
model PipelineStage {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id])
  key         String
  label       String
  order       Int
  isTerminal  Boolean  @default(false) @map("is_terminal")
  isConverted Boolean  @default(false) @map("is_converted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, key])
  @@index([schoolId, order])
  @@map("pipeline_stage")
}

// Admission document collection (FR-EG-6). fileLocation is whatever the Storage
// interface returns (backend/src/lib/storage.ts) - local disk in dev, swappable
// for S3 later, same pattern as CsvExportLog.fileLocation.
model Document {
  id               String   @id @default(uuid()) @db.Uuid
  enquiryId        String   @map("enquiry_id") @db.Uuid
  enquiry          Enquiry  @relation(fields: [enquiryId], references: [id])
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       AppUser  @relation(fields: [uploadedByUserId], references: [id])
  fileName         String   @map("file_name")
  fileLocation     String   @map("file_location")
  mimeType         String   @map("mime_type")
  fileSize         Int      @map("file_size")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  @@index([enquiryId])
  @@map("document")
}

// Recurring CSV export config (FR-EG-11) - one per school. The worker
// (backend/src/worker.ts) checks lastRunAt against frequency each tick.
model CsvExportSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @unique @map("school_id") @db.Uuid
  school     School   @relation(fields: [schoolId], references: [id])
  frequency  String   @default("weekly")
  isActive   Boolean  @default(false) @map("is_active")
  lastRunAt  DateTime? @map("last_run_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("csv_export_schedule")
}

model EnquiryStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  enquiryId       String   @map("enquiry_id") @db.Uuid
  enquiry         Enquiry  @relation(fields: [enquiryId], references: [id])
  fromStatus      String?  @map("from_status")
  toStatus        String   @map("to_status")
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  changedBy       AppUser? @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime @default(now()) @map("changed_at")

  @@map("enquiry_stage_history")
}

model EnquiryNote {
  id             String   @id @default(uuid()) @db.Uuid
  enquiryId      String   @map("enquiry_id") @db.Uuid
  enquiry        Enquiry  @relation(fields: [enquiryId], references: [id])
  authorUserId   String?  @map("author_user_id") @db.Uuid
  author         AppUser? @relation(fields: [authorUserId], references: [id])
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([enquiryId, createdAt])
  @@map("enquiry_note")
}

// Channel is one of: sms, email
model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  channel   String
  name      String
  body      String
  language  String   @default("English")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  followUpTasks FollowUpTask[]

  @@index([schoolId, channel])
  @@map("message_template")
}

// Channel is one of: sms, email. Status is one of: pending, sent, failed, cancelled
model FollowUpTask {
  id               String          @id @default(uuid()) @db.Uuid
  enquiryId        String          @map("enquiry_id") @db.Uuid
  enquiry          Enquiry         @relation(fields: [enquiryId], references: [id])
  assignedToUserId String          @map("assigned_to_user_id") @db.Uuid
  assignedTo       AppUser         @relation(fields: [assignedToUserId], references: [id])
  dueAt            DateTime        @map("due_at")
  channel          String
  templateId       String          @map("template_id") @db.Uuid
  template         MessageTemplate @relation(fields: [templateId], references: [id])
  status           String          @default("pending")
  sentAt           DateTime?       @map("sent_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  createdBy        String?         @map("created_by") @db.Uuid
  updatedBy        String?         @map("updated_by") @db.Uuid

  @@index([assignedToUserId, status])
  @@map("follow_up_task")
}

// fee_status is a placeholder only in this build phase (no fee module yet)
model StudentStub {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  school          School       @relation(fields: [schoolId], references: [id])
  sourceEnquiryId String       @unique @map("source_enquiry_id") @db.Uuid
  sourceEnquiry   Enquiry      @relation(fields: [sourceEnquiryId], references: [id])
  fullName        String       @map("full_name")
  dateOfBirth     DateTime     @map("date_of_birth") @db.Date
  classSectionId  String       @map("class_section_id") @db.Uuid
  classSection    ClassSection @relation(fields: [classSectionId], references: [id])
  guardianName    String       @map("guardian_name")
  guardianContact String       @map("guardian_contact")
  admissionDate   DateTime     @map("admission_date") @db.Date
  feeStatus       String       @default("pending") @map("fee_status")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  createdBy       String?      @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid

  personalisationSuggestions PersonalisationSuggestion[]
  submissions                Submission[]

  @@index([schoolId])
  @@map("student_stub")
}

// Export uses a single fixed, standard column format across all schools (FR-EG-11), no per-school mapping.
// Status is one of: success, failed
model CsvExportLog {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  school            School   @relation(fields: [schoolId], references: [id])
  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedBy       AppUser  @relation(fields: [requestedByUserId], references: [id])
  schedule          String?
  runAt             DateTime @default(now()) @map("run_at")
  rowCount          Int      @map("row_count")
  status            String
  fileLocation      String?  @map("file_location")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  @@index([schoolId])
  @@map("csv_export_log")
}

// ===== AI Module (Module 2, FR-AI-1..6) =====
// backend/src/lib/ai.ts's AiProvider interface is the only thing that talks to
// a model (a stub by default - see that file). Everything below is ordinary
// persistence, same as Module 1.

model LessonPlan {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  school         School        @relation(fields: [schoolId], references: [id])
  teacherUserId  String        @map("teacher_user_id") @db.Uuid
  teacher        AppUser       @relation(fields: [teacherUserId], references: [id])
  classSectionId String?       @map("class_section_id") @db.Uuid
  classSection   ClassSection? @relation(fields: [classSectionId], references: [id])
  topic          String
  board          String
  format         String        @default("lesson_plan")
  content        String
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([schoolId, teacherUserId])
  @@map("lesson_plan")
}

model ResearchReport {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  school        School   @relation(fields: [schoolId], references: [id])
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  teacher       AppUser  @relation(fields: [teacherUserId], references: [id])
  topic         String
  board         String
  content       String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, teacherUserId])
  @@map("research_report")
}

// Status is one of: draft, published
model Assignment {
  id                     String       @id @default(uuid()) @db.Uuid
  schoolId               String       @map("school_id") @db.Uuid
  school                 School       @relation(fields: [schoolId], references: [id])
  teacherUserId          String       @map("teacher_user_id") @db.Uuid
  teacher                AppUser      @relation(fields: [teacherUserId], references: [id])
  classSectionId         String       @map("class_section_id") @db.Uuid
  classSection           ClassSection @relation(fields: [classSectionId], references: [id])
  title                  String
  questions              Json
  personalisationEnabled Boolean      @default(false) @map("personalisation_enabled")
  status                 String       @default("draft")
  publishedAt            DateTime?    @map("published_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  personalisationSuggestions PersonalisationSuggestion[]
  submissions                Submission[]

  @@index([schoolId, classSectionId])
  @@map("assignment")
}

// This is the model FR-AI-2's mandatory teacher-initiated fallback design turns
// on. status is one of: pending, approved, overridden, opted_out. appliedMix is
// set ONLY by PATCH /personalisation-suggestions/:id
// (backend/src/routes/assignments.ts) - no other code path may write it, per
// Docs/Dev/EduWand_Engineering_PRD.md section 6.4. A fresh row (and fresh
// teacher decision) is generated per assignment - nothing here persists or
// auto-applies to a later assignment.
model PersonalisationSuggestion {
  id              String      @id @default(uuid()) @db.Uuid
  assignmentId    String      @map("assignment_id") @db.Uuid
  assignment      Assignment  @relation(fields: [assignmentId], references: [id])
  studentStubId   String      @map("student_stub_id") @db.Uuid
  studentStub     StudentStub @relation(fields: [studentStubId], references: [id])
  suggestedMix    Json        @map("suggested_mix")
  reasoning       String
  status          String      @default("pending")
  appliedMix      Json?       @map("applied_mix")
  decidedByUserId String?     @map("decided_by_user_id") @db.Uuid
  decidedBy       AppUser?    @relation(fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?   @map("decided_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([assignmentId, studentStubId])
  @@map("personalisation_suggestion")
}

// A teacher logs a submission on a student's behalf (Student role has no login
// in this build phase - PRD section 3, "structural shell only").
model Submission {
  id            String      @id @default(uuid()) @db.Uuid
  assignmentId  String      @map("assignment_id") @db.Uuid
  assignment    Assignment  @relation(fields: [assignmentId], references: [id])
  studentStubId String      @map("student_stub_id") @db.Uuid
  studentStub   StudentStub @relation(fields: [studentStubId], references: [id])
  answers       Json
  submittedAt   DateTime    @default(now()) @map("submitted_at")

  grade Grade?

  @@unique([assignmentId, studentStubId])
  @@map("submission")
}

// Status is one of: pending, ai_graded, released
model Grade {
  id                  String     @id @default(uuid()) @db.Uuid
  submissionId        String     @unique @map("submission_id") @db.Uuid
  submission          Submission @relation(fields: [submissionId], references: [id])
  aiScore             Float?     @map("ai_score")
  aiFeedback          String?    @map("ai_feedback")
  finalScore          Float?     @map("final_score")
  finalFeedback       String?    @map("final_feedback")
  flaggedForAttention Boolean    @default(false) @map("flagged_for_attention")
  status              String     @default("pending")
  overriddenByUserId  String?    @map("overridden_by_user_id") @db.Uuid
  overriddenBy        AppUser?   @relation(fields: [overriddenByUserId], references: [id])
  releasedAt          DateTime?  @map("released_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@map("grade")
}

// Written on every AI generation call (lesson plan, research report,
// personalisation suggestion, grading) for cost tracking and the Admin
// Dashboard's AI Usage Analytics screen (FR-AI-4).
model AiUsageLog {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  school        School   @relation(fields: [schoolId], references: [id])
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  teacher       AppUser  @relation(fields: [teacherUserId], references: [id])
  feature       String
  model         String
  status        String   @default("success")
  durationMs    Int?     @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([schoolId, teacherUserId])
  @@map("ai_usage_log")
}

// Student login (phone + OTP, no password). Keyed by phone rather than by
// StudentStub because guardianContact can be shared by siblings - one OTP
// verifies the phone, then /auth/student/select picks which StudentStub to
// issue a token for. consumedAt prevents replaying a used code.
model StudentOtpRequest {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String
  otpCodeHash String    @map("otp_code_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("student_otp_request")
}

// Staff (AppUser) password reset - same shape/lifecycle as StudentOtpRequest,
// keyed by email instead of phone since staff sign in with email+password.
model PasswordResetRequest {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  otpCodeHash String    @map("otp_code_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_request")
}

// Minimal admin-action audit trail - who invited/disabled/changed-role/deleted
// what, and when. Not a full change-history system (no before/after diffing
// beyond a small metadata blob) - just enough to answer "who did this."
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorEmail   String   @map("actor_email")
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id") @db.Uuid
  targetLabel  String?  @map("target_label")
  schoolId     String?  @map("school_id") @db.Uuid
  trustId      String?  @map("trust_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([trustId, createdAt])
  @@map("audit_log")
}
