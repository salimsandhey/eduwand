// EduWand backend — Prisma schema
// Models are added module by module. This file currently covers only the
// Platform and Tenancy tables (Docs/Dev/EduWand_Database_Schema.md, section 2).
// Enrolment Growth Engine and AI Module tables are added in later steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Onboarding fields added per the admin dashboard's Trust/School onboarding
// flow review (see chat 15 Aug 2026) - the create forms previously only took
// name + contact email, with no named human contact and no registration/
// billing detail on record. trustType is one of: society, trust,
// section_8_company, private_limited, other (free text, not enum-enforced).
model Trust {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  legalName             String?  @map("legal_name")
  contactEmail          String?  @map("contact_email")
  contactPersonName     String?  @map("contact_person_name")
  contactPersonPhone    String?  @map("contact_person_phone")
  registeredAddress     String?  @map("registered_address")
  gstNumber             String?  @map("gst_number")
  trustType             String?  @map("trust_type")
  expectedSchoolCount   Int?     @map("expected_school_count")
  status                String   @default("active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdBy             String?  @map("created_by") @db.Uuid
  updatedBy             String?  @map("updated_by") @db.Uuid

  schools School[]

  @@map("trust")
}

model School {
  id                        String   @id @default(uuid()) @db.Uuid
  trustId                   String   @map("trust_id") @db.Uuid
  trust                     Trust    @relation(fields: [trustId], references: [id])
  name                      String
  board                     String
  address                   String?
  timezone                  String   @default("Asia/Kolkata")
  incumbentErp              String?  @map("incumbent_erp")
  principalName             String?  @map("principal_name")
  principalPhone            String?  @map("principal_phone")
  expectedStudentStrength   Int?     @map("expected_student_strength")
  status                    String   @default("onboarding")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  createdBy                 String?  @map("created_by") @db.Uuid
  updatedBy                 String?  @map("updated_by") @db.Uuid

  academicYears     AcademicYear[]
  users             AppUser[]
  userSchoolAccess  UserSchoolAccess[]
  enquiries         Enquiry[]
  studentStubs      StudentStub[]
  csvExportLogs     CsvExportLog[]
  pipelineStages    PipelineStage[]
  csvExportSchedule CsvExportSchedule?
  lessonPlans       LessonPlan[]
  researchReports   ResearchReport[]
  assignments       Assignment[]
  aiUsageLogs       AiUsageLog[]
  topics            Topic[]
  schoolFormatTemplates SchoolFormatTemplate[]
  classBandConfig   ClassBandConfig?
  communicationMessages CommunicationMessage[]

  @@map("school")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  label     String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  classSections ClassSection[]

  @@map("academic_year")
}

model ClassSection {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  className      String       @map("class_name")
  sectionName    String       @map("section_name")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  studentStubs StudentStub[]
  lessonPlans  LessonPlan[]
  assignments  Assignment[]
  topics       Topic[]
  communicationMessages CommunicationMessage[]
  teacherAssignments ClassSectionTeacher[]

  @@map("class_section")
}

// Which teachers are assigned to which class sections - managed by school
// admin (admin-dashboard), consumed by the mobile app to scope Lesson Studio's
// "My Classes" screen to only the classes a teacher actually teaches. Class-
// level, not subject-scoped: subject already lives as free text on Topic.
model ClassSectionTeacher {
  id             String       @id @default(uuid()) @db.Uuid
  classSectionId String       @map("class_section_id") @db.Uuid
  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  teacherUserId  String       @map("teacher_user_id") @db.Uuid
  teacher        AppUser      @relation(fields: [teacherUserId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([classSectionId, teacherUserId])
  @@map("class_section_teacher")
}

// Role is one of: front_desk, counsellor, teacher, admin, leadership
// (kept as free text to match the reference schema; enforce the allowed set in application code)
model AppUser {
  id             String   @id @default(uuid()) @db.Uuid
  trustId        String?  @map("trust_id") @db.Uuid
  schoolId       String?  @map("school_id") @db.Uuid
  school         School?  @relation(fields: [schoolId], references: [id])
  fullName       String   @map("full_name")
  email          String   @unique
  phone          String?
  role           String
  authProviderId String?  @map("auth_provider_id")
  passwordHash   String?  @map("password_hash")
  status         String   @default("invited")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  schoolAccess        UserSchoolAccess[]
  ownedEnquiries      Enquiry[]             @relation("EnquiryOwner")
  enquiryStageChanges EnquiryStageHistory[]
  enquiryNotes        EnquiryNote[]
  assignedFollowUps   FollowUpTask[]
  csvExportLogs       CsvExportLog[]
  uploadedDocuments   Document[]
  lessonPlans         LessonPlan[]
  researchReports     ResearchReport[]
  assignments         Assignment[]
  personalisationDecisions PersonalisationSuggestion[]
  gradeOverrides      Grade[]
  aiUsageLogs         AiUsageLog[]
  topics              Topic[]
  generations         Generation[]
  observations        Observation[]
  sentCommunicationMessages CommunicationMessage[]
  classSectionAssignments ClassSectionTeacher[]

  @@map("app_user")
}

// Maps a user to multiple schools within a trust, for staff assigned across more than one school
model UserSchoolAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      AppUser  @relation(fields: [userId], references: [id])
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, schoolId])
  @@map("user_school_access")
}

// Status is one of: new, contacted, visit, application, admitted, enrolled, lost
// Source is one of: phone, walk_in, website, referral, event, social
model Enquiry {
  id                   String    @id @default(uuid()) @db.Uuid
  schoolId             String    @map("school_id") @db.Uuid
  school               School    @relation(fields: [schoolId], references: [id])
  contactName          String    @map("contact_name")
  contactPhone         String    @map("contact_phone")
  contactEmail         String?   @map("contact_email")
  source               String
  gradeInterest        String?   @map("grade_interest")
  // Captured at intake so the child's identity isn't conflated with the
  // guardian's contact details (contactName is the person the counsellor is
  // talking to, not necessarily the student) - see chat 15 Aug 2026.
  studentName          String?   @map("student_name")
  studentDateOfBirth   DateTime? @map("student_date_of_birth") @db.Date
  // guardianRelation is one of: mother, father, guardian, other
  guardianRelation     String?   @map("guardian_relation")
  // Profile photo: either an uploaded file (photoLocation/photoMimeType, via
  // the Storage interface - backend/src/lib/storage.ts) or a picked preset
  // avatar (avatarKey, one of unified-app's bundled avatar-01..avatar-10).
  // Mutually exclusive - setting one clears the other (see enquiries.ts).
  photoLocation        String?   @map("photo_location")
  photoMimeType        String?   @map("photo_mime_type")
  avatarKey            String?   @map("avatar_key")
  status               String    @default("new")
  lostReason           String?   @map("lost_reason")
  ownerUserId          String?   @map("owner_user_id") @db.Uuid
  owner                AppUser?  @relation("EnquiryOwner", fields: [ownerUserId], references: [id])
  duplicateOfEnquiryId String?   @map("duplicate_of_enquiry_id") @db.Uuid
  duplicateOf          Enquiry?  @relation("EnquiryDuplicate", fields: [duplicateOfEnquiryId], references: [id])
  duplicates           Enquiry[] @relation("EnquiryDuplicate")
  consentCaptured      Boolean   @default(false) @map("consent_captured")
  erasedAt             DateTime? @map("erased_at")
  // Admission-in-progress state, ahead of the final confirm-admission call that
  // creates the StudentStub - lets the Admission tab survive navigating away
  // mid-fill instead of losing everything (unified-app EnquiryDetailScreen).
  admissionDraft        Json?     @map("admission_draft")
  admissionStartedAt    DateTime? @map("admission_started_at")
  admissionCompletedAt  DateTime? @map("admission_completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            String?   @map("created_by") @db.Uuid
  updatedBy            String?   @map("updated_by") @db.Uuid

  stageHistory  EnquiryStageHistory[]
  notes         EnquiryNote[]
  followUpTasks FollowUpTask[]
  studentStub   StudentStub?
  documents     Document[]

  @@index([schoolId, status])
  @@index([schoolId, contactPhone])
  @@map("enquiry")
}

// Configurable admissions pipeline (FR-EG-3): stages are per-school, not a fixed
// enum. is_terminal marks a non-sequential outcome (e.g. "lost"), is_converted
// marks a stage that counts toward the conversion rate (e.g. admitted/enrolled).
// New schools are seeded with the same 7 default stages this replaces
// (see lib/pipeline-stages.ts) so existing behavior is unchanged out of the box.
model PipelineStage {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id])
  key         String
  label       String
  order       Int
  isTerminal  Boolean  @default(false) @map("is_terminal")
  isConverted Boolean  @default(false) @map("is_converted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, key])
  @@index([schoolId, order])
  @@map("pipeline_stage")
}

// Admission document collection (FR-EG-6). fileLocation is whatever the Storage
// interface returns (backend/src/lib/storage.ts) - local disk in dev, swappable
// for S3 later, same pattern as CsvExportLog.fileLocation.
// documentType is one of: student_photo, birth_certificate, transfer_certificate,
// previous_marksheet, id_proof, address_proof, other - a fixed checklist for now
// (FR-EG-6 admission document collection), matching the Admission tab's
// required-documents checklist. Nullable for documents uploaded before this
// field existed.
model Document {
  id               String   @id @default(uuid()) @db.Uuid
  enquiryId        String   @map("enquiry_id") @db.Uuid
  enquiry          Enquiry  @relation(fields: [enquiryId], references: [id])
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       AppUser  @relation(fields: [uploadedByUserId], references: [id])
  fileName         String   @map("file_name")
  fileLocation     String   @map("file_location")
  mimeType         String   @map("mime_type")
  fileSize         Int      @map("file_size")
  documentType      String?  @map("document_type")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  @@index([enquiryId])
  @@map("document")
}

// Recurring CSV export config (FR-EG-11) - one per school. The worker
// (backend/src/worker.ts) checks lastRunAt against frequency each tick.
model CsvExportSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @unique @map("school_id") @db.Uuid
  school     School   @relation(fields: [schoolId], references: [id])
  frequency  String   @default("weekly")
  isActive   Boolean  @default(false) @map("is_active")
  lastRunAt  DateTime? @map("last_run_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("csv_export_schedule")
}

model EnquiryStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  enquiryId       String   @map("enquiry_id") @db.Uuid
  enquiry         Enquiry  @relation(fields: [enquiryId], references: [id])
  fromStatus      String?  @map("from_status")
  toStatus        String   @map("to_status")
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  changedBy       AppUser? @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime @default(now()) @map("changed_at")

  @@map("enquiry_stage_history")
}

// type is one of: lead_note, admission_note, system_note - lets the UI show a
// note under the tab it belongs to instead of one undifferentiated list.
model EnquiryNote {
  id             String   @id @default(uuid()) @db.Uuid
  enquiryId      String   @map("enquiry_id") @db.Uuid
  enquiry        Enquiry  @relation(fields: [enquiryId], references: [id])
  authorUserId   String?  @map("author_user_id") @db.Uuid
  author         AppUser? @relation(fields: [authorUserId], references: [id])
  body           String
  type           String   @default("lead_note")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([enquiryId, createdAt])
  @@map("enquiry_note")
}

// Channel is one of: sms, email
model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  channel   String
  name      String
  body      String
  language  String   @default("English")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  followUpTasks FollowUpTask[]

  @@index([schoolId, channel])
  @@map("message_template")
}

// Channel is one of: sms, email. Status is one of: pending, sent, failed, cancelled
model FollowUpTask {
  id               String          @id @default(uuid()) @db.Uuid
  enquiryId        String          @map("enquiry_id") @db.Uuid
  enquiry          Enquiry         @relation(fields: [enquiryId], references: [id])
  assignedToUserId String          @map("assigned_to_user_id") @db.Uuid
  assignedTo       AppUser         @relation(fields: [assignedToUserId], references: [id])
  dueAt            DateTime        @map("due_at")
  channel          String
  templateId       String          @map("template_id") @db.Uuid
  template         MessageTemplate @relation(fields: [templateId], references: [id])
  status           String          @default("pending")
  sentAt           DateTime?       @map("sent_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  createdBy        String?         @map("created_by") @db.Uuid
  updatedBy        String?         @map("updated_by") @db.Uuid

  @@index([assignedToUserId, status])
  @@map("follow_up_task")
}

// fee_status is a placeholder only in this build phase (no fee module yet)
model StudentStub {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  school          School       @relation(fields: [schoolId], references: [id])
  sourceEnquiryId String       @unique @map("source_enquiry_id") @db.Uuid
  sourceEnquiry   Enquiry      @relation(fields: [sourceEnquiryId], references: [id])
  fullName        String       @map("full_name")
  dateOfBirth     DateTime     @map("date_of_birth") @db.Date
  classSectionId  String       @map("class_section_id") @db.Uuid
  classSection    ClassSection @relation(fields: [classSectionId], references: [id])
  guardianName    String       @map("guardian_name")
  guardianContact String       @map("guardian_contact")
  admissionDate   DateTime     @map("admission_date") @db.Date
  feeStatus       String       @default("pending") @map("fee_status")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  createdBy       String?      @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid

  personalisationSuggestions PersonalisationSuggestion[]
  submissions                Submission[]
  receivedCommunicationMessages CommunicationMessage[] @relation("CommunicationRecipientStudent")
  sentCommunicationMessages     CommunicationMessage[] @relation("CommunicationSenderStudent")

  @@index([schoolId])
  @@map("student_stub")
}

// Export uses a single fixed, standard column format across all schools (FR-EG-11), no per-school mapping.
// Status is one of: success, failed
model CsvExportLog {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  school            School   @relation(fields: [schoolId], references: [id])
  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedBy       AppUser  @relation(fields: [requestedByUserId], references: [id])
  schedule          String?
  runAt             DateTime @default(now()) @map("run_at")
  rowCount          Int      @map("row_count")
  status            String
  fileLocation      String?  @map("file_location")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  @@index([schoolId])
  @@map("csv_export_log")
}

// ===== AI Module (Module 2) =====
// backend/src/lib/ai.ts's AiProvider interface is the only thing that talks to
// a model (a stub by default - see that file). Everything below is ordinary
// persistence, same as Module 1.
//
// Rebuilt 11 Aug 2026 against the client's AI Module Build Document
// (Docs/Client/EduWand_AI_Module_User Journey.pdf) - see
// Docs/Dev/AI_Module_Rebuild_Plan.md for the phased plan this follows. Topic
// is now the spine every generation/assignment/observation/report belongs to.
// LessonPlan/ResearchReport are kept (read-only for historical rows) pending
// a follow-up cleanup migration once Generation fully covers their reads.

// Phase 1: the container every generation, assignment, and report belongs to.
model Topic {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  school         School        @relation(fields: [schoolId], references: [id])
  teacherUserId  String        @map("teacher_user_id") @db.Uuid
  teacher        AppUser       @relation(fields: [teacherUserId], references: [id])
  classSectionId String        @map("class_section_id") @db.Uuid
  classSection   ClassSection  @relation(fields: [classSectionId], references: [id])
  subject        String
  name           String
  board          String
  status         String        @default("active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  contextSources   ContextSource[]
  generations      Generation[]
  observations     Observation[]
  assignments      Assignment[]
  attainmentReport AttainmentReport?
  communicationMessages CommunicationMessage[]

  @@index([schoolId, teacherUserId])
  @@index([classSectionId, subject])
  @@map("topic")
}

// sourceType is one of: pdf, docx, pptx, image, url, idream_k12
// extractionStatus is one of: pending, extracted, failed_no_text
model ContextSource {
  id                    String   @id @default(uuid()) @db.Uuid
  topicId               String   @map("topic_id") @db.Uuid
  topic                 Topic    @relation(fields: [topicId], references: [id])
  sourceType            String   @map("source_type")
  fileLocation          String?  @map("file_location")
  originalFilename      String?  @map("original_filename")
  sourceUrl             String?  @map("source_url")
  idreamK12ReferenceId  String?  @map("idream_k12_reference_id")
  extractionStatus      String   @default("pending") @map("extraction_status")
  extractedText         String?  @map("extracted_text")
  extractionError       String?  @map("extraction_error")
  createdAt             DateTime @default(now()) @map("created_at")

  // Which generations this source's extracted text actually fed - lets the
  // app answer "what sources was this generation based on" (client build doc
  // acceptance criterion), not just "what sources exist on the topic."
  generations Generation[]

  @@index([topicId])
  @@map("context_source")
}

// The output template applied to generations/attainment reports so documents
// are standardised across a school. Ownership (school vs EduWand at
// onboarding) is open - Docs/Dev/EduWand_Engineering_PRD.md section 6.7, Q-16.
model SchoolFormatTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  school       School   @relation(fields: [schoolId], references: [id])
  appliesTo    String   @map("applies_to")
  templateBody String   @map("template_body")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  generations Generation[]

  @@unique([schoolId, appliesTo])
  @@map("school_format_template")
}

model Observation {
  id           String   @id @default(uuid()) @db.Uuid
  topicId      String   @map("topic_id") @db.Uuid
  topic        Topic    @relation(fields: [topicId], references: [id])
  authorUserId String   @map("author_user_id") @db.Uuid
  author       AppUser  @relation(fields: [authorUserId], references: [id])
  body         String
  recordedAt   DateTime @default(now()) @map("recorded_at")

  @@index([topicId])
  @@map("observation")
}

// Phase 2: supersedes LessonPlan/ResearchReport. outputType is one of:
// lesson_plan, custom_activity_report, flashcards, presentation,
// explanatory_video. mode is one of: plan, generate.
// editedOutput, once set, is authoritative everywhere this generation is
// read (distribution, attainment report) - never aiOutput once edited.
model Generation {
  id                     String                @id @default(uuid()) @db.Uuid
  topicId                String                @map("topic_id") @db.Uuid
  topic                  Topic                 @relation(fields: [topicId], references: [id])
  teacherUserId          String                @map("teacher_user_id") @db.Uuid
  teacher                AppUser               @relation(fields: [teacherUserId], references: [id])
  outputType             String                @map("output_type")
  mode                   String                @default("generate")
  classCount             Int?                  @map("class_count")
  minutesPerClass        Int?                  @map("minutes_per_class")
  language               String                @default("English")
  customPrompt           String?               @map("custom_prompt")
  aiOutput               String                @map("ai_output")
  editedOutput           String?               @map("edited_output")
  schoolFormatTemplateId String?               @map("school_format_template_id") @db.Uuid
  schoolFormatTemplate   SchoolFormatTemplate? @relation(fields: [schoolFormatTemplateId], references: [id])
  modelUsed              String                @map("model_used")
  modelVersion           String?               @map("model_version")
  promptVersion          String?               @map("prompt_version")
  generationStatus       String                @default("succeeded") @map("generation_status")
  generatedAt            DateTime              @default(now()) @map("generated_at")

  contextSources ContextSource[]

  @@index([topicId])
  @@index([teacherUserId])
  @@map("generation")
}

model AttainmentReport {
  id                    String    @id @default(uuid()) @db.Uuid
  topicId               String    @unique @map("topic_id") @db.Uuid
  topic                 Topic     @relation(fields: [topicId], references: [id])
  bloomsTaxonomyMapping Json?     @map("blooms_taxonomy_mapping")
  whatWasDone           String?   @map("what_was_done")
  outcomes              String?   @map("outcomes")
  improvementNotes      String?   @map("improvement_notes")
  pdfFileLocation       String?   @map("pdf_file_location")
  generatedAt           DateTime  @default(now()) @map("generated_at")

  @@map("attainment_report")
}

model LessonPlan {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  school         School        @relation(fields: [schoolId], references: [id])
  teacherUserId  String        @map("teacher_user_id") @db.Uuid
  teacher        AppUser       @relation(fields: [teacherUserId], references: [id])
  classSectionId String?       @map("class_section_id") @db.Uuid
  classSection   ClassSection? @relation(fields: [classSectionId], references: [id])
  topic          String
  board          String
  format         String        @default("lesson_plan")
  content        String
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([schoolId, teacherUserId])
  @@map("lesson_plan")
}

model ResearchReport {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  school        School   @relation(fields: [schoolId], references: [id])
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  teacher       AppUser  @relation(fields: [teacherUserId], references: [id])
  topic         String
  board         String
  content       String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, teacherUserId])
  @@map("research_report")
}

// Status is one of: draft, published
// topicId is nullable during the Phase 1/2 transition (Docs/Dev/AI_Module_Rebuild_Plan.md)
// - existing assignments predate Topic and are not backfilled in this phase.
// New assignments created via Phase 3's rebuilt Assignment Lab always set it.
model Assignment {
  id                     String       @id @default(uuid()) @db.Uuid
  schoolId               String       @map("school_id") @db.Uuid
  school                 School       @relation(fields: [schoolId], references: [id])
  topicId                String?      @map("topic_id") @db.Uuid
  topic                  Topic?       @relation(fields: [topicId], references: [id])
  teacherUserId          String       @map("teacher_user_id") @db.Uuid
  teacher                AppUser      @relation(fields: [teacherUserId], references: [id])
  classSectionId         String       @map("class_section_id") @db.Uuid
  classSection           ClassSection @relation(fields: [classSectionId], references: [id])
  title                  String
  questions              Json
  personalisationEnabled Boolean      @default(false) @map("personalisation_enabled")
  status                 String       @default("draft")
  publishedAt            DateTime?    @map("published_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  personalisationSuggestions PersonalisationSuggestion[]
  submissions                Submission[]
  answerKeys                  AnswerKey[]

  @@index([schoolId, classSectionId])
  @@index([topicId])
  @@map("assignment")
}

// Phase 3 groundwork: the teacher-verified answer is authoritative, never the
// AI's original, same edited-supersedes-generated pattern as Generation.
model AnswerKey {
  id                      String     @id @default(uuid()) @db.Uuid
  assignmentId            String     @map("assignment_id") @db.Uuid
  assignment              Assignment @relation(fields: [assignmentId], references: [id])
  questionIndex           Int        @map("question_index")
  photoSubmissionRequired Boolean    @default(false) @map("photo_submission_required")
  aiAnswer                String     @map("ai_answer")
  teacherVerifiedAnswer   String?    @map("teacher_verified_answer")
  marks                   Float      @default(1)
  createdAt               DateTime   @default(now()) @map("created_at")

  @@unique([assignmentId, questionIndex])
  @@map("answer_key")
}

// This is the model FR-AI-2's mandatory teacher-initiated fallback design turns
// on. status is one of: pending, approved, overridden, opted_out. appliedMix is
// set ONLY by PATCH /personalisation-suggestions/:id
// (backend/src/routes/assignments.ts) - no other code path may write it, per
// Docs/Dev/EduWand_Engineering_PRD.md section 6.4. A fresh row (and fresh
// teacher decision) is generated per assignment - nothing here persists or
// auto-applies to a later assignment.
model PersonalisationSuggestion {
  id              String      @id @default(uuid()) @db.Uuid
  assignmentId    String      @map("assignment_id") @db.Uuid
  assignment      Assignment  @relation(fields: [assignmentId], references: [id])
  studentStubId   String      @map("student_stub_id") @db.Uuid
  studentStub     StudentStub @relation(fields: [studentStubId], references: [id])
  suggestedMix    Json        @map("suggested_mix")
  reasoning       String
  status          String      @default("pending")
  appliedMix      Json?       @map("applied_mix")
  decidedByUserId String?     @map("decided_by_user_id") @db.Uuid
  decidedBy       AppUser?    @relation(fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?   @map("decided_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([assignmentId, studentStubId])
  @@map("personalisation_suggestion")
}

// A teacher logs a submission on a student's behalf today; Phase 4 adds a
// student's-own POST /student/submissions using the same table.
// submissionType is one of: online, photo.
model Submission {
  id                String      @id @default(uuid()) @db.Uuid
  assignmentId      String      @map("assignment_id") @db.Uuid
  assignment        Assignment  @relation(fields: [assignmentId], references: [id])
  studentStubId     String      @map("student_stub_id") @db.Uuid
  studentStub       StudentStub @relation(fields: [studentStubId], references: [id])
  answers           Json
  submissionType    String      @default("online") @map("submission_type")
  photoFileLocation String?     @map("photo_file_location")
  ocrExtractedText  String?     @map("ocr_extracted_text")
  ocrConfidence     Float?      @map("ocr_confidence")
  submittedAt       DateTime    @default(now()) @map("submitted_at")

  grade Grade?

  @@unique([assignmentId, studentStubId])
  @@map("submission")
}

// Status is one of: pending, ai_graded, released (kept for backward
// compatibility). releasedToStudent is the actual gate new code should check
// - equivalent to status:"released" but explicit. performanceBand is one of:
// level_1 (>80%), level_2 (50-80%), level_3 (<50%), thresholds editable per
// school via ClassBandConfig.
model Grade {
  id                  String     @id @default(uuid()) @db.Uuid
  submissionId        String     @unique @map("submission_id") @db.Uuid
  submission          Submission @relation(fields: [submissionId], references: [id])
  aiScore             Float?     @map("ai_score")
  aiFeedback          String?    @map("ai_feedback")
  aiNextStep          String?    @map("ai_next_step")
  finalScore          Float?     @map("final_score")
  finalFeedback       String?    @map("final_feedback")
  performanceBand     String?    @map("performance_band")
  flaggedForAttention Boolean    @default(false) @map("flagged_for_attention")
  status              String     @default("pending")
  overriddenByUserId  String?    @map("overridden_by_user_id") @db.Uuid
  overriddenBy        AppUser?   @relation(fields: [overriddenByUserId], references: [id])
  releasedToStudent   Boolean    @default(false) @map("released_to_student")
  releasedAt          DateTime?  @map("released_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@map("grade")
}

// Editable per-school override of the default performance band thresholds.
model ClassBandConfig {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @unique @map("school_id") @db.Uuid
  school           School   @relation(fields: [schoolId], references: [id])
  level1MinPercent Float    @default(80) @map("level_1_min_percent")
  level2MinPercent Float    @default(50) @map("level_2_min_percent")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("class_band_config")
}

// Backs all four Communication Hub channels (Docs/Dev/AI_Module_Rebuild_Plan.md
// Phase 4, extended). channel is one of: parent_weekly_update,
// teacher_to_student, teacher_to_class, student_to_teacher. The first three
// original channels are in-app messaging between accounts that already exist
// in the system (teacher <-> student), so they deliver immediately -
// deliveryStatus:"pending" only ever applies to parent_weekly_update, since
// that one needs an external channel (SMS/email) the client doc's own Q-08
// gap leaves unresolved (Section 7.3 references a Q-08 that Section 8 never
// defines). senderStudentStubId is set for student-initiated messages -
// StudentStub has no AppUser row, so it can't use senderUserId.
model CommunicationMessage {
  id                       String        @id @default(uuid()) @db.Uuid
  schoolId                 String        @map("school_id") @db.Uuid
  school                   School        @relation(fields: [schoolId], references: [id])
  channel                  String
  senderUserId             String?       @map("sender_user_id") @db.Uuid
  sender                   AppUser?      @relation(fields: [senderUserId], references: [id])
  senderStudentStubId      String?       @map("sender_student_stub_id") @db.Uuid
  senderStudentStub        StudentStub?  @relation("CommunicationSenderStudent", fields: [senderStudentStubId], references: [id])
  recipientStudentStubId   String?       @map("recipient_student_stub_id") @db.Uuid
  recipientStudentStub     StudentStub?  @relation("CommunicationRecipientStudent", fields: [recipientStudentStubId], references: [id])
  recipientClassSectionId  String?       @map("recipient_class_section_id") @db.Uuid
  recipientClassSection    ClassSection? @relation(fields: [recipientClassSectionId], references: [id])
  topicId                  String?       @map("topic_id") @db.Uuid
  topic                    Topic?        @relation(fields: [topicId], references: [id])
  body                     String
  deliveryMechanism        String?       @map("delivery_mechanism")
  deliveryStatus           String        @default("sent") @map("delivery_status")
  sentAt                   DateTime?     @map("sent_at")
  createdAt                DateTime      @default(now()) @map("created_at")

  @@index([schoolId, channel])
  @@index([recipientStudentStubId])
  @@index([senderStudentStubId])
  @@map("communication_message")
}

// Written on every AI generation call (lesson plan, research report,
// personalisation suggestion, grading) for cost tracking and the Admin
// Dashboard's AI Usage Analytics screen (FR-AI-4).
model AiUsageLog {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  school        School   @relation(fields: [schoolId], references: [id])
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  teacher       AppUser  @relation(fields: [teacherUserId], references: [id])
  feature       String
  model         String
  status        String   @default("success")
  durationMs    Int?     @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([schoolId, teacherUserId])
  @@map("ai_usage_log")
}

// Student login (phone + OTP, no password). Keyed by phone rather than by
// StudentStub because guardianContact can be shared by siblings - one OTP
// verifies the phone, then /auth/student/select picks which StudentStub to
// issue a token for. consumedAt prevents replaying a used code.
model StudentOtpRequest {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String
  otpCodeHash String    @map("otp_code_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("student_otp_request")
}

// Staff (AppUser) password reset - same shape/lifecycle as StudentOtpRequest,
// keyed by email instead of phone since staff sign in with email+password.
model PasswordResetRequest {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  otpCodeHash String    @map("otp_code_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_request")
}

// Minimal admin-action audit trail - who invited/disabled/changed-role/deleted
// what, and when. Not a full change-history system (no before/after diffing
// beyond a small metadata blob) - just enough to answer "who did this."
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorEmail   String   @map("actor_email")
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id") @db.Uuid
  targetLabel  String?  @map("target_label")
  schoolId     String?  @map("school_id") @db.Uuid
  trustId      String?  @map("trust_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([trustId, createdAt])
  @@map("audit_log")
}
