// EduWand backend — Prisma schema
// Models are added module by module. This file currently covers only the
// Platform and Tenancy tables (Docs/Dev/EduWand_Database_Schema.md, section 2).
// Enrolment Growth Engine and AI Module tables are added in later steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Onboarding fields added per the admin dashboard's Trust/School onboarding
// flow review (see chat 15 Aug 2026) - the create forms previously only took
// name + contact email, with no named human contact and no registration/
// billing detail on record. trustType is one of: society, trust,
// section_8_company, private_limited, other (free text, not enum-enforced).
model Trust {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  legalName           String?  @map("legal_name")
  contactEmail        String?  @map("contact_email")
  contactPersonName   String?  @map("contact_person_name")
  contactPersonPhone  String?  @map("contact_person_phone")
  registeredAddress   String?  @map("registered_address")
  gstNumber           String?  @map("gst_number")
  trustType           String?  @map("trust_type")
  expectedSchoolCount Int?     @map("expected_school_count")
  status              String   @default("active")
  // Billing plan this trust is on - drives per-teacher-seat credit grants
  // (Docs/superpowers/plans/2026-09-09-individual-teacher-onboarding-and-credits.md).
  // Nullable so existing trusts predating the credits system aren't broken;
  // resolution code falls back to the platform default plan/credit setting
  // when null.
  planId              String?  @map("plan_id") @db.Uuid
  plan                Plan?    @relation(fields: [planId], references: [id])
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid

  schools School[]

  @@map("trust")
}

// accountType is one of: institutional, individual. "individual" schools are
// auto-provisioned personal workspaces for self-signed-up teachers (see the
// credits/onboarding plan doc referenced on Trust.planId) - a teacher acts as
// admin of their own individual school only (backend/src/routes/academic-
// structure.ts authorizeForSchool), never of an institutional one.
model School {
  id                      String   @id @default(uuid()) @db.Uuid
  trustId                 String   @map("trust_id") @db.Uuid
  trust                   Trust    @relation(fields: [trustId], references: [id])
  name                    String
  board                   String
  accountType             String   @default("institutional") @map("account_type")
  // Per-teacher override for individual accounts - null means "use the
  // platform default" (PlatformSetting "individual_default_class_limit" /
  // "individual_default_subject_limit", resolved in lib/limits.ts). Ignored
  // for institutional schools, which are never capped.
  classLimit              Int?     @map("class_limit")
  subjectLimit            Int?     @map("subject_limit")
  address                 String?
  // Presentation "School format" template branding - null until a
  // school/teacher sets it up via the format-template screen.
  logoUrl                 String?  @map("logo_url")
  primaryColor            String?  @map("primary_color")
  secondaryColor          String?  @map("secondary_color")
  timezone                String   @default("Asia/Kolkata")
  incumbentErp            String?  @map("incumbent_erp")
  principalName           String?  @map("principal_name")
  principalPhone          String?  @map("principal_phone")
  expectedStudentStrength Int?     @map("expected_student_strength")
  status                  String   @default("onboarding")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  createdBy               String?  @map("created_by") @db.Uuid
  updatedBy               String?  @map("updated_by") @db.Uuid

  academicYears         AcademicYear[]
  families              Family[]
  users                 AppUser[]
  userSchoolAccess      UserSchoolAccess[]
  enquiries             Enquiry[]
  studentStubs          StudentStub[]
  csvExportLogs         CsvExportLog[]
  pipelineStages        PipelineStage[]
  csvExportSchedule     CsvExportSchedule?
  lessonPlans           LessonPlan[]
  researchReports       ResearchReport[]
  assignments           Assignment[]
  assessments           Assessment[]
  aiUsageLogs           AiUsageLog[]
  topics                Topic[]
  schoolFormatTemplates SchoolFormatTemplate[]
  classBandConfig       ClassBandConfig?
  communicationMessages CommunicationMessage[]
  subjects              Subject[]
  formDefinitions       FormDefinition[]
  feePlans              FeePlan[]
  approvalChainSteps    ApprovalChainStep[]
  aiConversations       AiConversation[]
  subjectChangeRequests SubjectChangeRequest[]
  boardChangeTickets    BoardChangeTicket[]
  classChangeRequests   ClassChangeRequest[]
  timetableSlots        TimetableSlot[]
  calendarTasks         CalendarTask[]

  @@map("school")
}

// Per-school gateway for Topic.subject - previously free text with no source
// of truth, which fragmented (case/spelling variants) and undermined
// filtering by subject in Lesson Studio. Admin-managed, teacher-facing as a
// closed picker - same "fixed set, not free text" pattern School.board's
// hardcoded options already use.
model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([schoolId, name])
  @@map("subject")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  label     String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  classSections ClassSection[]
  enquiries     Enquiry[]
  feePlans      FeePlan[]

  @@map("academic_year")
}

model ClassSection {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  className      String       @map("class_name")
  sectionName    String       @map("section_name")
  // Set false when a ClassChangeRequest "replace" is approved - the class
  // and all its data (students/topics/assignments) stay untouched, it just
  // stops counting toward the teacher's active class limit and drops out of
  // normal listings. See Docs/superpowers/plans/2026-09-09-individual-
  // teacher-onboarding-and-credits.md.
  isActive       Boolean      @default(true) @map("is_active")
  // Shareable join-link token - public, unauthenticated students/parents use
  // it to submit a ClassJoinRequest (never direct entry).
  joinCode       String       @unique @default(cuid()) @map("join_code")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  studentStubs          StudentStub[]
  lessonPlans           LessonPlan[]
  assignments           Assignment[]
  assessments           Assessment[]
  topics                Topic[]
  communicationMessages CommunicationMessage[]
  teacherAssignments    ClassSectionTeacher[]
  joinRequests          ClassJoinRequest[]
  timetableSlots        TimetableSlot[]

  @@map("class_section")
}

// Which teachers are assigned to which class sections - managed by school
// admin (admin-dashboard), consumed by the mobile app to scope Lesson Studio's
// "My Classes" screen to only the classes a teacher actually teaches. Class-
// level, not subject-scoped: subject already lives as free text on Topic.
model ClassSectionTeacher {
  id             String       @id @default(uuid()) @db.Uuid
  classSectionId String       @map("class_section_id") @db.Uuid
  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  teacherUserId  String       @map("teacher_user_id") @db.Uuid
  teacher        AppUser      @relation(fields: [teacherUserId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([classSectionId, teacherUserId])
  @@map("class_section_teacher")
}

// A weekly recurring period on a teacher's timetable. Set by the school
// admin for institutional teachers, and by the teacher themselves for
// individual accounts (authorizeForSchool already treats an individual
// teacher as admin of their own school). weekday is ISO: 1=Mon ... 7=Sun.
// startTime/endTime are 24h "HH:mm" strings - a timetable is a wall-clock
// schedule, not an instant, so there is no timezone to get wrong.
model TimetableSlot {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  school         School       @relation(fields: [schoolId], references: [id])
  teacherUserId  String       @map("teacher_user_id") @db.Uuid
  teacher        AppUser      @relation(fields: [teacherUserId], references: [id])
  classSectionId String       @map("class_section_id") @db.Uuid
  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  subject        String
  weekday        Int
  startTime      String       @map("start_time")
  endTime        String       @map("end_time")
  room           String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([schoolId, teacherUserId, weekday])
  @@map("timetable_slot")
}

// A teacher's personal to-do on a specific day, shown on the home-screen
// calendar. taskDate is a calendar date (no time/timezone); dueTime is an
// optional "HH:mm" for ordering within the day.
model CalendarTask {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  school        School    @relation(fields: [schoolId], references: [id])
  teacherUserId String    @map("teacher_user_id") @db.Uuid
  teacher       AppUser   @relation(fields: [teacherUserId], references: [id])
  title         String
  notes         String?
  taskDate      DateTime  @map("task_date") @db.Date
  dueTime       String?   @map("due_time")
  isDone        Boolean   @default(false) @map("is_done")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([teacherUserId, taskDate])
  @@map("calendar_task")
}

// Role is one of: front_desk, counsellor, teacher, admin, leadership
// (kept as free text to match the reference schema; enforce the allowed set in application code)
model AppUser {
  id             String   @id @default(uuid()) @db.Uuid
  trustId        String?  @map("trust_id") @db.Uuid
  schoolId       String?  @map("school_id") @db.Uuid
  school         School?  @relation(fields: [schoolId], references: [id])
  fullName       String   @map("full_name")
  email          String   @unique
  phone          String?
  role           String
  authProviderId String?  @map("auth_provider_id")
  passwordHash   String?  @map("password_hash")
  // Self-service profile photo (unified-app ProfileScreen). Same
  // mutually-exclusive uploaded-file vs preset-avatar shape as Enquiry
  // (see the photoLocation/avatarKey comment there) - setting one clears
  // the other. Managed only through /auth/me/* by the user themselves.
  photoLocation  String?  @map("photo_location")
  photoMimeType  String?  @map("photo_mime_type")
  avatarKey      String?  @map("avatar_key")
  status         String   @default("invited")
  // First-login product tour (mobile, teacher role only for now). Set true
  // once the teacher dismisses/completes the tour so it never shows again.
  hasSeenOnboardingTour Boolean  @default(false) @map("has_seen_onboarding_tour")
  // "Complete your profile" prompt (mobile, staff roles). Set true only when
  // the user taps Skip - never shown again after that. A user who completes
  // their profile simply stops qualifying for the prompt, no flag needed.
  hasDismissedProfilePrompt Boolean @default(false) @map("has_dismissed_profile_prompt")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  schoolAccess               UserSchoolAccess[]
  ownedEnquiries             Enquiry[]                   @relation("EnquiryOwner")
  enquiryStageChanges        EnquiryStageHistory[]
  enquiryNotes               EnquiryNote[]
  assignedFollowUps          FollowUpTask[]
  csvExportLogs              CsvExportLog[]
  uploadedDocuments          Document[]
  lessonPlans                LessonPlan[]
  researchReports            ResearchReport[]
  assignments                Assignment[]
  assessments                Assessment[]
  personalisationDecisions   PersonalisationSuggestion[]
  gradeOverrides             Grade[]
  aiUsageLogs                AiUsageLog[]
  topics                     Topic[]
  generations                Generation[]
  observations               Observation[]
  sentCommunicationMessages  CommunicationMessage[]
  classSectionAssignments    ClassSectionTeacher[]
  timetableSlots             TimetableSlot[]
  calendarTasks              CalendarTask[]
  roleGrants                UserRoleGrant[]
  interviews                 InterviewRecord[]           @relation("InterviewConductedBy")
  approvals                  EnquiryApproval[]           @relation("ApprovalDecidedBy")
  creditAccount              TeacherCreditAccount?
  creditLedgerEntries        CreditLedgerEntry[]
  subjectChangeRequests      SubjectChangeRequest[]      @relation("SubjectChangeRequester")
  subjectChangeDecisions     SubjectChangeRequest[]      @relation("SubjectChangeDecider")
  boardChangeTicketsRaised   BoardChangeTicket[]         @relation("BoardChangeRaiser")
  boardChangeTicketDecisions BoardChangeTicket[]         @relation("BoardChangeDecider")
  classChangeRequests        ClassChangeRequest[]        @relation("ClassChangeRequester")
  classChangeDecisions       ClassChangeRequest[]        @relation("ClassChangeDecider")
  classJoinDecisions         ClassJoinRequest[]          @relation("ClassJoinDecider")
  onboardingTasks            TeacherOnboardingTask[]

  @@map("app_user")
}

// Additive role grants on top of AppUser.role (Phase 1 of Growth Engine access
// control) - lets a user hold extra roles (e.g. front_desk primary + counsellor
// grant) without a full per-school role redesign. Effective role set for a user
// = { user.role } union { grant.role for each row here }.
model UserRoleGrant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      AppUser  @relation(fields: [userId], references: [id])
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_role_grant")
}

// Maps a user to multiple schools within a trust, for staff assigned across more than one school
model UserSchoolAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      AppUser  @relation(fields: [userId], references: [id])
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, schoolId])
  @@map("user_school_access")
}

// Status is one of: new, contacted, visit, application, admitted, enrolled, lost
// Source is one of: phone, walk_in, website, referral, event, social
model Enquiry {
  id                    String       @id @default(uuid()) @db.Uuid
  schoolId              String       @map("school_id") @db.Uuid
  school                School       @relation(fields: [schoolId], references: [id])
  academicYearId        String       @map("academic_year_id") @db.Uuid
  academicYear          AcademicYear @relation(fields: [academicYearId], references: [id])
  familyId              String?      @map("family_id") @db.Uuid
  family                Family?      @relation(fields: [familyId], references: [id])
  feePlanId             String?      @map("fee_plan_id") @db.Uuid
  feePlan               FeePlan?     @relation(fields: [feePlanId], references: [id])
  contactName           String       @map("contact_name")
  contactPhone          String       @map("contact_phone")
  contactEmail          String?      @map("contact_email")
  source                String
  gradeInterest         String?      @map("grade_interest")
  // Captured at intake so the child's identity isn't conflated with the
  // guardian's contact details (contactName is the person the counsellor is
  // talking to, not necessarily the student) - see chat 15 Aug 2026.
  studentName           String?      @map("student_name")
  studentDateOfBirth    DateTime?    @map("student_date_of_birth") @db.Date
  // guardianRelation is one of: mother, father, guardian, other
  guardianRelation      String?      @map("guardian_relation")
  // Profile photo: either an uploaded file (photoLocation/photoMimeType, via
  // the Storage interface - backend/src/lib/storage.ts) or a picked preset
  // avatar (avatarKey, one of unified-app's bundled avatar-01..avatar-10).
  // Mutually exclusive - setting one clears the other (see enquiries.ts).
  photoLocation         String?      @map("photo_location")
  photoMimeType         String?      @map("photo_mime_type")
  avatarKey             String?      @map("avatar_key")
  status                String       @default("new")
  lostReason            String?      @map("lost_reason")
  ownerUserId           String?      @map("owner_user_id") @db.Uuid
  owner                 AppUser?     @relation("EnquiryOwner", fields: [ownerUserId], references: [id])
  duplicateOfEnquiryId  String?      @map("duplicate_of_enquiry_id") @db.Uuid
  duplicateOf           Enquiry?     @relation("EnquiryDuplicate", fields: [duplicateOfEnquiryId], references: [id])
  duplicates            Enquiry[]    @relation("EnquiryDuplicate")
  consentCaptured       Boolean      @default(false) @map("consent_captured")
  erasedAt              DateTime?    @map("erased_at")
  // Admission-in-progress state, ahead of the final confirm-admission call that
  // creates the StudentStub - lets the Admission tab survive navigating away
  // mid-fill instead of losing everything (unified-app EnquiryDetailScreen).
  admissionDraft        Json?        @map("admission_draft")
  admissionStartedAt    DateTime?    @map("admission_started_at")
  admissionCompletedAt  DateTime?    @map("admission_completed_at")
  // Answers to the school's active enquiry_intake FormDefinition's dynamic
  // fields (Docs/Dev/GrowthEngine_Rebuild_Plan.md Phase 2), keyed by
  // FormField.key. Parallel to admissionDraft, but for intake-time fields
  // rather than the admission tab.
  formResponses         Json?        @map("form_responses")
  approvalChainSnapshot Json?        @map("approval_chain_snapshot")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  createdBy             String?      @map("created_by") @db.Uuid
  updatedBy             String?      @map("updated_by") @db.Uuid

  stageHistory  EnquiryStageHistory[]
  notes         EnquiryNote[]
  followUpTasks FollowUpTask[]
  studentStub   StudentStub?
  documents     Document[]
  interviews    InterviewRecord[]
  approvals     EnquiryApproval[]

  @@index([schoolId, status])
  @@index([schoolId, academicYearId, status])
  @@index([schoolId, contactPhone])
  @@index([feePlanId])
  @@map("enquiry")
}

model InterviewRecord {
  id                String   @id @default(uuid()) @db.Uuid
  enquiryId         String   @map("enquiry_id") @db.Uuid
  enquiry           Enquiry  @relation(fields: [enquiryId], references: [id])
  conductedByUserId String   @map("conducted_by_user_id") @db.Uuid
  conductedBy       AppUser  @relation("InterviewConductedBy", fields: [conductedByUserId], references: [id])
  interviewDate     DateTime @map("interview_date")
  score             Decimal? @db.Decimal(6, 2)
  maxScore          Decimal? @map("max_score") @db.Decimal(6, 2)
  notes             String
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([enquiryId, interviewDate])
  @@map("interview_record")
}

model FeePlan {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  amount         Decimal      @db.Decimal(12, 2)
  frequency      String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  enquiries Enquiry[]

  @@index([schoolId, academicYearId, isActive])
  @@map("fee_plan")
}

model ApprovalChainStep {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  school       School   @relation(fields: [schoolId], references: [id])
  order        Int
  requiredRole String   @map("required_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, order])
  @@map("approval_chain_step")
}

model EnquiryApproval {
  id               String   @id @default(uuid()) @db.Uuid
  enquiryId        String   @map("enquiry_id") @db.Uuid
  enquiry          Enquiry  @relation(fields: [enquiryId], references: [id])
  stepOrder        Int      @map("step_order")
  approvedByUserId String   @map("approved_by_user_id") @db.Uuid
  approvedBy       AppUser  @relation("ApprovalDecidedBy", fields: [approvedByUserId], references: [id])
  decision         String
  comment          String?
  decidedAt        DateTime @default(now()) @map("decided_at")

  @@unique([enquiryId, stepOrder])
  @@map("enquiry_approval")
}

model Family {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @map("school_id") @db.Uuid
  school              School   @relation(fields: [schoolId], references: [id])
  primaryContactName  String   @map("primary_contact_name")
  primaryContactPhone String   @map("primary_contact_phone")
  createdAt           DateTime @default(now()) @map("created_at")

  enquiries Enquiry[]

  @@index([schoolId, primaryContactPhone])
  @@map("family")
}

// Configurable admissions pipeline (FR-EG-3): stages are per-school, not a fixed
// enum. is_terminal marks a non-sequential outcome (e.g. "lost"), is_converted
// marks a stage that counts toward the conversion rate (e.g. admitted/enrolled).
// New schools are seeded with the same 7 default stages this replaces
// (see lib/pipeline-stages.ts) so existing behavior is unchanged out of the box.
model PipelineStage {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id])
  key         String
  label       String
  order       Int
  isTerminal  Boolean  @default(false) @map("is_terminal")
  isConverted Boolean  @default(false) @map("is_converted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, key])
  @@index([schoolId, order])
  @@map("pipeline_stage")
}

// Form builder foundation (Docs/Dev/GrowthEngine_Rebuild_Plan.md Phase 2) - lets
// each school customize the dynamic fields captured at intake, on the
// admission tab, and on the document checklist, without a schema change per
// school. purpose is one of: enquiry_intake, admission_detail,
// document_checklist (free text, matching the reference schema's other
// "enum" fields - enforced in application code, not a real Postgres enum).
//
// Only one FormDefinition may be isActive per (schoolId, purpose) at a time.
// Prisma (6.19, this repo's pinned version) has no schema-level support for a
// filtered/partial unique index (no `where` clause on @@unique), so that
// invariant is enforced in application code (backend/src/routes/form-
// definitions.ts deactivates any existing active definition, in the same
// transaction, whenever a new one is activated) rather than at the DB layer -
// same tradeoff already accepted for CsvExportSchedule.isActive. The
// [schoolId, purpose, isActive] index below just makes the "find the active
// one" lookup (the hot path, run on every intake/admission/document screen)
// an index scan instead of a table scan.
model FormDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  purpose   String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  fields FormField[]

  @@index([schoolId, purpose, isActive])
  @@map("form_definition")
}

// fieldType is one of: text, number, date, select, multiselect, checkbox,
// textarea, file (free text, application-enforced - see FormDefinition).
// requiredAtStage, when set, is a PipelineStage.key (or Enquiry-lifecycle
// stage) marking when the field becomes required, e.g. "application" for
// admission_detail fields that only need answering once the Admission tab
// unlocks - null means "required (if at all) from the start."
model FormField {
  id               String         @id @default(uuid()) @db.Uuid
  formDefinitionId String         @map("form_definition_id") @db.Uuid
  formDefinition   FormDefinition @relation(fields: [formDefinitionId], references: [id])
  key              String
  label            String
  fieldType        String         @map("field_type")
  options          Json?
  order            Int
  isRequired       Boolean        @default(false) @map("is_required")
  requiredAtStage  String?        @map("required_at_stage")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([formDefinitionId, key])
  @@index([formDefinitionId, order])
  @@map("form_field")
}

// Admission document collection (FR-EG-6). fileLocation is whatever the Storage
// interface returns (backend/src/lib/storage.ts) - local disk in dev, swappable
// for S3 later, same pattern as CsvExportLog.fileLocation.
// documentType is one of: student_photo, birth_certificate, transfer_certificate,
// previous_marksheet, id_proof, address_proof, other - a fixed checklist for now
// (FR-EG-6 admission document collection), matching the Admission tab's
// required-documents checklist. Nullable for documents uploaded before this
// field existed.
model Document {
  id               String   @id @default(uuid()) @db.Uuid
  enquiryId        String   @map("enquiry_id") @db.Uuid
  enquiry          Enquiry  @relation(fields: [enquiryId], references: [id])
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       AppUser  @relation(fields: [uploadedByUserId], references: [id])
  fileName         String   @map("file_name")
  fileLocation     String   @map("file_location")
  mimeType         String   @map("mime_type")
  fileSize         Int      @map("file_size")
  documentType     String?  @map("document_type")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  @@index([enquiryId])
  @@map("document")
}

// Recurring CSV export config (FR-EG-11) - one per school. The worker
// (backend/src/worker.ts) checks lastRunAt against frequency each tick.
model CsvExportSchedule {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @unique @map("school_id") @db.Uuid
  school    School    @relation(fields: [schoolId], references: [id])
  frequency String    @default("weekly")
  isActive  Boolean   @default(false) @map("is_active")
  lastRunAt DateTime? @map("last_run_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("csv_export_schedule")
}

model EnquiryStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  enquiryId       String   @map("enquiry_id") @db.Uuid
  enquiry         Enquiry  @relation(fields: [enquiryId], references: [id])
  fromStatus      String?  @map("from_status")
  toStatus        String   @map("to_status")
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  changedBy       AppUser? @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime @default(now()) @map("changed_at")

  @@map("enquiry_stage_history")
}

// type is one of: lead_note, admission_note, system_note - lets the UI show a
// note under the tab it belongs to instead of one undifferentiated list.
model EnquiryNote {
  id           String   @id @default(uuid()) @db.Uuid
  enquiryId    String   @map("enquiry_id") @db.Uuid
  enquiry      Enquiry  @relation(fields: [enquiryId], references: [id])
  authorUserId String?  @map("author_user_id") @db.Uuid
  author       AppUser? @relation(fields: [authorUserId], references: [id])
  body         String
  type         String   @default("lead_note")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([enquiryId, createdAt])
  @@map("enquiry_note")
}

// Channel is one of: sms, email
model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  channel   String
  name      String
  body      String
  language  String   @default("English")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  followUpTasks FollowUpTask[]

  @@index([schoolId, channel])
  @@map("message_template")
}

// Channel is one of: sms, email. Status is one of: pending, sent, failed, cancelled
model FollowUpTask {
  id               String          @id @default(uuid()) @db.Uuid
  enquiryId        String          @map("enquiry_id") @db.Uuid
  enquiry          Enquiry         @relation(fields: [enquiryId], references: [id])
  assignedToUserId String          @map("assigned_to_user_id") @db.Uuid
  assignedTo       AppUser         @relation(fields: [assignedToUserId], references: [id])
  dueAt            DateTime        @map("due_at")
  channel          String
  templateId       String          @map("template_id") @db.Uuid
  template         MessageTemplate @relation(fields: [templateId], references: [id])
  status           String          @default("pending")
  sentAt           DateTime?       @map("sent_at")
  outcome          String?
  nextFollowUpAt   DateTime?       @map("next_follow_up_at")
  escalatedAt      DateTime?       @map("escalated_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  createdBy        String?         @map("created_by") @db.Uuid
  updatedBy        String?         @map("updated_by") @db.Uuid

  @@index([assignedToUserId, status])
  @@map("follow_up_task")
}

// fee_status is a placeholder only in this build phase (no fee module yet)
model StudentStub {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  school          School       @relation(fields: [schoolId], references: [id])
  // Nullable - most students are admitted through the Enquiry pipeline and
  // get one, but a school onboarding its existing roster can add a student
  // directly (POST /students) without ever having an Enquiry for them.
  sourceEnquiryId String?      @unique @map("source_enquiry_id") @db.Uuid
  sourceEnquiry   Enquiry?     @relation(fields: [sourceEnquiryId], references: [id])
  fullName        String       @map("full_name")
  dateOfBirth     DateTime     @map("date_of_birth") @db.Date
  classSectionId  String       @map("class_section_id") @db.Uuid
  classSection    ClassSection @relation(fields: [classSectionId], references: [id])
  guardianName    String       @map("guardian_name")
  guardianContact String       @map("guardian_contact")
  admissionDate   DateTime     @map("admission_date") @db.Date
  feeStatus       String       @default("pending") @map("fee_status")
  // A physical clicker's hardware DEVICE_ID (see clicker.ino), assigned once
  // per student per class. A live Present session's Control page maps an
  // incoming {"id":N,"ans":"A"} packet to this student via seatNumber, then
  // records it exactly as if the teacher had tapped it manually - see
  // admin-dashboard's PresentControlPage.tsx receiver connection.
  seatNumber      Int?         @map("seat_number")
  // Profile picture the student sets themselves (Profile tab): an uploaded
  // photo (photoLocation/photoMimeType) or one of unified-app's bundled
  // student-avatar-01..20 (avatarKey). Setting one clears the other; neither
  // set = the app's default silhouette. See backend/src/routes/auth-me.ts.
  photoLocation   String?      @map("photo_location")
  photoMimeType   String?      @map("photo_mime_type")
  avatarKey       String?      @map("avatar_key")
  // status is one of: active, removed. Soft delete only - Submission/Grade/
  // PersonalisationSuggestion/CommunicationMessage all reference a student
  // with no cascade rule, so a real row delete would fail once a student
  // has any activity. Removed students are hidden from normal listings but
  // their history stays intact. See Docs/superpowers/plans/2026-09-09-
  // individual-teacher-onboarding-and-credits.md.
  status          String       @default("active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  createdBy       String?      @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid

  personalisationSuggestions    PersonalisationSuggestion[]
  submissions                   Submission[]
  assessmentResponses           AssessmentResponse[]
  receivedCommunicationMessages CommunicationMessage[]      @relation("CommunicationRecipientStudent")
  sentCommunicationMessages     CommunicationMessage[]      @relation("CommunicationSenderStudent")

  @@index([schoolId])
  // Two students in the same class can't share a clicker number - Postgres
  // treats NULLs as distinct here, so any number of not-yet-assigned
  // students (seatNumber null) coexist fine.
  @@unique([classSectionId, seatNumber])
  @@map("student_stub")
}

// Export uses a single fixed, standard column format across all schools (FR-EG-11), no per-school mapping.
// Status is one of: success, failed
model CsvExportLog {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  school            School   @relation(fields: [schoolId], references: [id])
  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedBy       AppUser  @relation(fields: [requestedByUserId], references: [id])
  schedule          String?
  runAt             DateTime @default(now()) @map("run_at")
  rowCount          Int      @map("row_count")
  status            String
  fileLocation      String?  @map("file_location")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  @@index([schoolId])
  @@map("csv_export_log")
}

// ===== AI Module (Module 2) =====
// backend/src/lib/ai.ts's AiProvider interface is the only thing that talks to
// a model (a stub by default - see that file). Everything below is ordinary
// persistence, same as Module 1.
//
// Rebuilt 11 Aug 2026 against the client's AI Module Build Document
// (Docs/Client/EduWand_AI_Module_User Journey.pdf) - see
// Docs/Dev/AI_Module_Rebuild_Plan.md for the phased plan this follows. Topic
// is now the spine every generation/assignment/observation/report belongs to.
// LessonPlan/ResearchReport are kept (read-only for historical rows) pending
// a follow-up cleanup migration once Generation fully covers their reads.

// Phase 1: the container every generation, assignment, and report belongs to.
model Topic {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  school         School       @relation(fields: [schoolId], references: [id])
  teacherUserId  String       @map("teacher_user_id") @db.Uuid
  teacher        AppUser      @relation(fields: [teacherUserId], references: [id])
  classSectionId String       @map("class_section_id") @db.Uuid
  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  subject        String
  name           String
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  contextSources        ContextSource[]
  generations           Generation[]
  observations          Observation[]
  assignments           Assignment[]
  assessments           Assessment[]
  attainmentReport      AttainmentReport?
  communicationMessages CommunicationMessage[]
  researchJobs          ContextResearchJob[]
  savedVideos           SavedVideo[]

  @@index([schoolId, teacherUserId])
  @@index([classSectionId, subject])
  @@map("topic")
}

// sourceType is one of: pdf, docx, pptx, image, url, youtube, idream_k12
// extractionStatus is one of: pending, extracted, failed_no_text
model ContextSource {
  id                   String   @id @default(uuid()) @db.Uuid
  topicId              String   @map("topic_id") @db.Uuid
  topic                Topic    @relation(fields: [topicId], references: [id])
  sourceType           String   @map("source_type")
  fileLocation         String?  @map("file_location")
  originalFilename     String?  @map("original_filename")
  sourceUrl            String?  @map("source_url")
  idreamK12ReferenceId String?  @map("idream_k12_reference_id")
  // Credit line for a source found by AI research (image author/licence, or
  // the site a PDF came from) - shown wherever the source is used as-is in
  // generated content. Null for teacher uploads.
  attribution          String?
  // PDFs only - total page count, captured at extraction time. Lets the
  // frontend offer a page-range picker for long documents (Generate setup).
  pageCount            Int?     @map("page_count")
  extractionStatus     String   @default("pending") @map("extraction_status")
  extractedText        String?  @map("extracted_text")
  extractionError      String?  @map("extraction_error")
  createdAt            DateTime @default(now()) @map("created_at")

  // Which generations this source's extracted text actually fed - lets the
  // app answer "what sources was this generation based on" (client build doc
  // acceptance criterion), not just "what sources exist on the topic."
  generations Generation[]

  @@index([topicId])
  @@map("context_source")
}

// AI Research mode: a NotebookLM-style workaround to the (unintegrated)
// iDream K-12 API - searches the web for candidate sources the teacher then
// approves/dismisses individually. status is one of: running, completed,
// failed. stage is one of: searching, reviewing, done. candidates is a JSON
// array of { id, title, url, type, snippet, status, contextSourceId? } -
// see backend/src/lib/context-research.ts for the shape.
model ContextResearchJob {
  id           String   @id @default(uuid()) @db.Uuid
  topicId      String   @map("topic_id") @db.Uuid
  topic        Topic    @relation(fields: [topicId], references: [id])
  status       String   @default("running")
  stage        String   @default("searching")
  candidates   Json     @default("[]")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([topicId])
  @@map("context_research_job")
}

// A reference video (found via AI Research's YouTube search - see
// lib/youtube-search.ts) a teacher chose to keep for a topic. Deliberately
// separate from ContextSource: these are never fed to the AI as context,
// only browsed/watched by the teacher, so they need none of ContextSource's
// extraction machinery - just enough to show a card and open the player.
model SavedVideo {
  id            String   @id @default(uuid()) @db.Uuid
  topicId       String   @map("topic_id") @db.Uuid
  topic         Topic    @relation(fields: [topicId], references: [id])
  videoId       String   @map("video_id")
  title         String
  channelTitle  String   @map("channel_title")
  thumbnailUrl  String   @map("thumbnail_url")
  duration      String
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([topicId, videoId])
  @@map("saved_video")
}

// The output template applied to generations/attainment reports so documents
// are standardised across a school. Ownership (school vs EduWand at
// onboarding) is open - Docs/Dev/EduWand_Engineering_PRD.md section 6.7, Q-16.
model SchoolFormatTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  school       School   @relation(fields: [schoolId], references: [id])
  appliesTo    String   @map("applies_to")
  templateBody String   @map("template_body")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  generations Generation[]

  @@unique([schoolId, appliesTo])
  @@map("school_format_template")
}

// Platform-wide (not per-school) override of the instruction text sent to
// the model for a given Generation.outputType - lets platform_admin tune
// prompts without a code deploy. A missing row for an outputType means "use
// the hardcoded default" (backend/src/lib/ai.ts DEFAULT_OUTPUT_TYPE_INSTRUCTIONS) -
// this table only ever holds overrides, never seeded with defaults, so
// resetting to default is just deleting the row.
model AiPromptTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  outputType      String   @unique @map("output_type")
  promptBody      String   @map("prompt_body")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ai_prompt_template")
}

model Observation {
  id           String   @id @default(uuid()) @db.Uuid
  topicId      String   @map("topic_id") @db.Uuid
  topic        Topic    @relation(fields: [topicId], references: [id])
  authorUserId String   @map("author_user_id") @db.Uuid
  author       AppUser  @relation(fields: [authorUserId], references: [id])
  body         String
  // Optional photo captured with the note (e.g. a whiteboard shot or student
  // work) - surfaced as its own section on the topic's attainment report.
  photoUrl     String?  @map("photo_url")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  @@index([topicId])
  @@map("observation")
}

// Phase 2: supersedes LessonPlan/ResearchReport. outputType is one of:
// lesson_plan, custom_activity_report, flashcards, presentation.
// mode is one of: plan, generate.
// editedOutput, once set, is authoritative everywhere this generation is
// read (distribution, attainment report) - never aiOutput once edited.
model Generation {
  id                     String                @id @default(uuid()) @db.Uuid
  topicId                String                @map("topic_id") @db.Uuid
  topic                  Topic                 @relation(fields: [topicId], references: [id])
  teacherUserId          String                @map("teacher_user_id") @db.Uuid
  teacher                AppUser               @relation(fields: [teacherUserId], references: [id])
  outputType             String                @map("output_type")
  mode                   String                @default("generate")
  classCount             Int?                  @map("class_count")
  minutesPerClass        Int?                  @map("minutes_per_class")
  language               String                @default("English")
  customPrompt           String?               @map("custom_prompt")
  // Only meaningful when outputType is "custom_activity_report" - see
  // ai.ts's ActivityGroupSize/ACTIVITY_RESOURCE_OPTIONS. Stored as real
  // columns (not folded into the output JSON like presentationTemplate is)
  // so a retry reuses them for free via this same row, the same way
  // classCount/minutesPerClass already do.
  activityGroupSize      String?               @map("activity_group_size")
  activityResources      String[]              @map("activity_resources")
  // Only meaningful when outputType is "custom_activity_report" - the
  // Learning Stage(s) (Bloom's Taxonomy) the teacher constrained this
  // activity report's objectives to. Empty means "let the AI choose freely",
  // same default-open behavior as before this existed.
  learningStages         String[]              @default([]) @map("learning_stages")
  // Presentation only (outputType === "presentation"). "reason" drives the
  // fixed slide-role sequence (see ai.ts's ROLE_SEQUENCES); "density" is the
  // one text-volume lever, ignored by "revision_deck" which always runs
  // dense. Both null for every other outputType and for presentations
  // generated before this flow existed (those fall back to the legacy
  // 8-layout free-form deck, rendered via PresentationView.tsx's legacy path).
  presentationReason     String?               @map("presentation_reason")
  presentationDensity    String?               @map("presentation_density")
  // Number of class periods this deck is split across (max 3) - distinct
  // from classCount above, which lesson_plan/custom_activity_report also use
  // for a different purpose (minutes-per-class scheduling, not slide count).
  // Presentation-only; null means "not this flow" (legacy deck, single class).
  presentationClasses    Int?                  @map("presentation_classes")
  // Step 8's outline: [{ role, classIndex, title, oneLiner }], written by the
  // outline pass and read/reordered/trimmed by the teacher before the
  // content-fill pass overwrites aiOutput with the full PresentationContent
  // JSON. Null once content-fill has run (or for any non-presentation /
  // legacy row).
  outline                Json?                 @map("outline")
  aiOutput               String                @map("ai_output")
  editedOutput           String?               @map("edited_output")
  schoolFormatTemplateId String?               @map("school_format_template_id") @db.Uuid
  schoolFormatTemplate   SchoolFormatTemplate? @relation(fields: [schoolFormatTemplateId], references: [id])
  modelUsed              String                @map("model_used")
  modelVersion           String?               @map("model_version")
  promptVersion          String?               @map("prompt_version")
  generationStatus       String                @default("succeeded") @map("generation_status")
  generatedAt            DateTime              @default(now()) @map("generated_at")
  // Exactly what the teacher selected for this generation - { contextSourceId,
  // pageFrom?, pageTo? }[]. The contextSources relation below still records
  // *which* sources were touched (for display); this carries the page-range
  // detail that relation can't. Null for generations created before source
  // selection existed - retry falls back to the contextSources relation then.
  selectedSources        Json?                 @map("selected_sources")

  // Separate from generationStatus (which is about whether the AI call
  // succeeded) - this gates /student/materials. draft = teacher-only,
  // published = visible to students per sharedWithAll/sharedStudentStubIds
  // below. Mirrors Assignment.status/publishedAt.
  shareStatus String    @default("draft") @map("share_status")
  publishedAt DateTime? @map("published_at")
  // When false, published visibility is limited to sharedStudentStubIds
  // (validated as members of the topic's own class section at publish time)
  // instead of the whole class - same String[] pattern as activityResources
  // above, not a join table, since this is just a snapshot of who was picked
  // at share time, not something else needs to query from the other side.
  sharedWithAll        Boolean  @default(true) @map("shared_with_all")
  sharedStudentStubIds String[] @default([]) @map("shared_student_stub_ids")

  // Which class periods (1-indexed, matching a stage's own "sessions" tag in
  // the lesson_plan content JSON) the teacher has actually taught, for a
  // lesson plan that spans more than one class (classCount > 1). Teacher-
  // reported progress, separate from generationStatus (whether the AI call
  // succeeded) and from Topic.status (archived/active) - a topic isn't
  // auto-closed just because every class has been ticked off.
  completedSessions Int[] @default([]) @map("completed_sessions")

  contextSources ContextSource[]
  assessments    Assessment[]

  @@index([topicId])
  @@index([teacherUserId])
  @@map("generation")
}

model AttainmentReport {
  id                    String   @id @default(uuid()) @db.Uuid
  topicId               String   @unique @map("topic_id") @db.Uuid
  topic                 Topic    @relation(fields: [topicId], references: [id])
  bloomsTaxonomyMapping Json?    @map("blooms_taxonomy_mapping")
  whatWasDone           String?  @map("what_was_done")
  outcomes              String?  @map("outcomes")
  improvementNotes      String?  @map("improvement_notes")
  pdfFileLocation       String?  @map("pdf_file_location")
  generatedAt           DateTime @default(now()) @map("generated_at")

  @@map("attainment_report")
}

model LessonPlan {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  school         School        @relation(fields: [schoolId], references: [id])
  teacherUserId  String        @map("teacher_user_id") @db.Uuid
  teacher        AppUser       @relation(fields: [teacherUserId], references: [id])
  classSectionId String?       @map("class_section_id") @db.Uuid
  classSection   ClassSection? @relation(fields: [classSectionId], references: [id])
  topic          String
  board          String
  format         String        @default("lesson_plan")
  content        String
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([schoolId, teacherUserId])
  @@map("lesson_plan")
}

model ResearchReport {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  school        School   @relation(fields: [schoolId], references: [id])
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  teacher       AppUser  @relation(fields: [teacherUserId], references: [id])
  topic         String
  board         String
  content       String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, teacherUserId])
  @@map("research_report")
}

// Status is one of: draft, published
// topicId is nullable during the Phase 1/2 transition (Docs/Dev/AI_Module_Rebuild_Plan.md)
// - existing assignments predate Topic and are not backfilled in this phase.
// New assignments created via Phase 3's rebuilt Assignment Lab always set it.
model Assignment {
  id                     String       @id @default(uuid()) @db.Uuid
  schoolId               String       @map("school_id") @db.Uuid
  school                 School       @relation(fields: [schoolId], references: [id])
  topicId                String?      @map("topic_id") @db.Uuid
  topic                  Topic?       @relation(fields: [topicId], references: [id])
  teacherUserId          String       @map("teacher_user_id") @db.Uuid
  teacher                AppUser      @relation(fields: [teacherUserId], references: [id])
  classSectionId         String       @map("class_section_id") @db.Uuid
  classSection           ClassSection @relation(fields: [classSectionId], references: [id])
  title                  String
  questions              Json
  // The setup params from the "Generate assignment with AI" flow
  // (backend/src/routes/assignments.ts POST /topics/:id/assignment-draft) -
  // stored so a single question can be regenerated later against the same
  // taught content and options. Null for manually created assignments.
  aiGenParams            Json?        @map("ai_gen_params")
  personalisationEnabled Boolean      @default(false) @map("personalisation_enabled")
  status                 String       @default("draft")
  publishedAt            DateTime?    @map("published_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  personalisationSuggestions PersonalisationSuggestion[]
  submissions                Submission[]
  answerKeys                 AnswerKey[]

  @@index([schoolId, classSectionId])
  @@index([topicId])
  @@map("assignment")
}

// Phase 3 groundwork: the teacher-verified answer is authoritative, never the
// AI's original, same edited-supersedes-generated pattern as Generation.
model AnswerKey {
  id                      String     @id @default(uuid()) @db.Uuid
  assignmentId            String     @map("assignment_id") @db.Uuid
  assignment              Assignment @relation(fields: [assignmentId], references: [id])
  // Keyed by the question's own id (the AssignmentQuestion.id inside the
  // questions JSON), not array position. Personalised delivery
  // (PersonalisationSuggestion.appliedMix, see lib/personalisation.ts) can
  // hand different students a different subset/order of the same
  // assignment's questions, so position alone can no longer identify a
  // question. questionIndex is kept only for stable display order.
  questionId              String     @map("question_id")
  questionIndex           Int        @map("question_index")
  photoSubmissionRequired Boolean    @default(false) @map("photo_submission_required")
  aiAnswer                String     @map("ai_answer")
  teacherVerifiedAnswer   String?    @map("teacher_verified_answer")
  marks                   Float      @default(1)
  createdAt               DateTime   @default(now()) @map("created_at")

  @@unique([assignmentId, questionId])
  @@index([assignmentId, questionIndex])
  @@map("answer_key")
}

// This is the model FR-AI-2's mandatory teacher-initiated fallback design turns
// on. status is one of: pending, approved, overridden, opted_out. appliedMix is
// set ONLY by PATCH /personalisation-suggestions/:id
// (backend/src/routes/assignments.ts) - no other code path may write it, per
// Docs/Dev/EduWand_Engineering_PRD.md section 6.4. A fresh row (and fresh
// teacher decision) is generated per assignment - nothing here persists or
// auto-applies to a later assignment.
model PersonalisationSuggestion {
  id              String      @id @default(uuid()) @db.Uuid
  assignmentId    String      @map("assignment_id") @db.Uuid
  assignment      Assignment  @relation(fields: [assignmentId], references: [id])
  studentStubId   String      @map("student_stub_id") @db.Uuid
  studentStub     StudentStub @relation(fields: [studentStubId], references: [id])
  suggestedMix    Json        @map("suggested_mix")
  reasoning       String
  status          String      @default("pending")
  appliedMix      Json?       @map("applied_mix")
  decidedByUserId String?     @map("decided_by_user_id") @db.Uuid
  decidedBy       AppUser?    @relation(fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?   @map("decided_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([assignmentId, studentStubId])
  @@map("personalisation_suggestion")
}

// A teacher logs a submission on a student's behalf today; Phase 4 adds a
// student's-own POST /student/submissions using the same table.
// submissionType is one of: online, photo.
model Submission {
  id                String      @id @default(uuid()) @db.Uuid
  assignmentId      String      @map("assignment_id") @db.Uuid
  assignment        Assignment  @relation(fields: [assignmentId], references: [id])
  studentStubId     String      @map("student_stub_id") @db.Uuid
  studentStub       StudentStub @relation(fields: [studentStubId], references: [id])
  answers           Json
  submissionType    String      @default("online") @map("submission_type")
  photoFileLocation String?     @map("photo_file_location")
  ocrExtractedText  String?     @map("ocr_extracted_text")
  ocrConfidence     Float?      @map("ocr_confidence")
  submittedAt       DateTime    @default(now()) @map("submitted_at")

  grade Grade?

  @@unique([assignmentId, studentStubId])
  @@map("submission")
}

// Status is one of: pending, ai_graded, released (kept for backward
// compatibility). releasedToStudent is the actual gate new code should check
// - equivalent to status:"released" but explicit. performanceBand is one of:
// level_1 (>80%), level_2 (50-80%), level_3 (<50%), thresholds editable per
// school via ClassBandConfig.
model Grade {
  id                  String     @id @default(uuid()) @db.Uuid
  submissionId        String     @unique @map("submission_id") @db.Uuid
  submission          Submission @relation(fields: [submissionId], references: [id])
  aiScore             Float?     @map("ai_score")
  aiFeedback          String?    @map("ai_feedback")
  aiNextStep          String?    @map("ai_next_step")
  // Per-question breakdown from the grading call - {questionId, correct
  // (null when the grader can't judge correctness, e.g. the offline
  // completeness heuristic), marksAwarded, note}[]. Feeds the class-insight
  // item analysis (backend/src/routes/submissions.ts) and the per-question
  // detail shown in GradingReviewScreen.
  questionDetails     Json?      @map("question_details")
  finalScore          Float?     @map("final_score")
  finalFeedback       String?    @map("final_feedback")
  performanceBand     String?    @map("performance_band")
  flaggedForAttention Boolean    @default(false) @map("flagged_for_attention")
  status              String     @default("pending")
  overriddenByUserId  String?    @map("overridden_by_user_id") @db.Uuid
  overriddenBy        AppUser?   @relation(fields: [overriddenByUserId], references: [id])
  releasedToStudent   Boolean    @default(false) @map("released_to_student")
  releasedAt          DateTime?  @map("released_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@map("grade")
}

// In-class quick quiz grounded in ONE specific lesson plan (generationId),
// not "everything taught on the topic" like Assignment - distinct from
// Assignment by design (homework-style/asynchronous) vs this (a synchronous
// pulse-check right after teaching). MCQ-only: a physical remote (under
// separate development) can only send "pressed B", and it's what makes
// grading free/instant (see AssessmentResponse.isCorrect). status is one of:
// capturing, completed.
model Assessment {
  id                        String    @id @default(uuid()) @db.Uuid
  schoolId                  String    @map("school_id") @db.Uuid
  school                    School    @relation(fields: [schoolId], references: [id])
  topicId                   String    @map("topic_id") @db.Uuid
  topic                     Topic     @relation(fields: [topicId], references: [id])
  generationId              String    @map("generation_id") @db.Uuid
  generation                Generation @relation(fields: [generationId], references: [id])
  teacherUserId             String    @map("teacher_user_id") @db.Uuid
  teacher                   AppUser   @relation(fields: [teacherUserId], references: [id])
  classSectionId            String    @map("class_section_id") @db.Uuid
  classSection              ClassSection @relation(fields: [classSectionId], references: [id])
  title                     String
  // MCQ-only: { id, prompt, options, correctOptionIndex }[]
  questions                 Json
  status                    String    @default("capturing")
  completedAt               DateTime? @map("completed_at")
  resultsReleasedToStudents Boolean   @default(false) @map("results_released_to_students")
  resultsReleasedAt         DateTime? @map("results_released_at")
  createdAt                 DateTime  @default(now()) @map("created_at")

  // Presenting on a screen (web/present.ts): a short-lived code stands in for
  // login on the classroom device - same pattern as ClassJoinRequest's
  // joinCode. One active code at a time; starting a new session overwrites it,
  // which invalidates whatever device still has the old link/tab open.
  presentCode             String?   @unique @map("present_code")
  presentCodeExpiresAt    DateTime? @map("present_code_expires_at")
  // Which question is currently being presented, and whether the class has
  // been shown the correct answer for it yet. Server-side (not per-client)
  // because the Display and Control pages are two different devices that
  // must show the same question.
  currentQuestionIndex    Int       @default(0) @map("current_question_index")
  currentQuestionRevealed Boolean   @default(false) @map("current_question_revealed")

  responses AssessmentResponse[]

  @@index([schoolId, classSectionId])
  @@index([topicId])
  @@map("assessment")
}

// One row per student per question - deliberately the same shape a future
// remote-button-press event would produce ({questionId, studentId,
// selectedOptionIndex} arriving live), so hardware integration later just
// writes into this same table from a different source, not a schema change.
model AssessmentResponse {
  id                  String     @id @default(uuid()) @db.Uuid
  assessmentId        String     @map("assessment_id") @db.Uuid
  assessment          Assessment @relation(fields: [assessmentId], references: [id])
  questionId          String     @map("question_id")
  studentStubId       String     @map("student_stub_id") @db.Uuid
  studentStub         StudentStub @relation(fields: [studentStubId], references: [id])
  // Null when isDoubt is true - a doubt is "I'm not sure", not a choice.
  selectedOptionIndex Int?       @map("selected_option_index")
  // Computed at write time via exact match against the question's
  // correctOptionIndex - no separate grading pass or Grade row needed.
  // Null when isDoubt is true (a doubt is neither right nor wrong).
  isCorrect           Boolean?   @map("is_correct")
  // The student pressed "I'm not sure" instead of picking an option (see
  // client's Step 6: a live doubt count alongside Correct/Wrong). Kept out of
  // correctRate/band math entirely rather than counted as wrong, so a topic
  // students are honestly unsure about doesn't read as "failed."
  isDoubt             Boolean    @default(false) @map("is_doubt")
  recordedAt          DateTime   @default(now()) @map("recorded_at")

  @@unique([assessmentId, questionId, studentStubId])
  @@index([assessmentId])
  @@map("assessment_response")
}

// Editable per-school override of the default performance band thresholds.
model ClassBandConfig {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @unique @map("school_id") @db.Uuid
  school           School   @relation(fields: [schoolId], references: [id])
  level1MinPercent Float    @default(80) @map("level_1_min_percent")
  level2MinPercent Float    @default(50) @map("level_2_min_percent")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("class_band_config")
}

// Backs all four Communication Hub channels (Docs/Dev/AI_Module_Rebuild_Plan.md
// Phase 4, extended). channel is one of: parent_weekly_update,
// teacher_to_student, teacher_to_class, student_to_teacher. The first three
// original channels are in-app messaging between accounts that already exist
// in the system (teacher <-> student), so they deliver immediately -
// deliveryStatus:"pending" only ever applies to parent_weekly_update, since
// that one needs an external channel (SMS/email) the client doc's own Q-08
// gap leaves unresolved (Section 7.3 references a Q-08 that Section 8 never
// defines). senderStudentStubId is set for student-initiated messages -
// StudentStub has no AppUser row, so it can't use senderUserId.
model CommunicationMessage {
  id                      String        @id @default(uuid()) @db.Uuid
  schoolId                String        @map("school_id") @db.Uuid
  school                  School        @relation(fields: [schoolId], references: [id])
  channel                 String
  senderUserId            String?       @map("sender_user_id") @db.Uuid
  sender                  AppUser?      @relation(fields: [senderUserId], references: [id])
  senderStudentStubId     String?       @map("sender_student_stub_id") @db.Uuid
  senderStudentStub       StudentStub?  @relation("CommunicationSenderStudent", fields: [senderStudentStubId], references: [id])
  recipientStudentStubId  String?       @map("recipient_student_stub_id") @db.Uuid
  recipientStudentStub    StudentStub?  @relation("CommunicationRecipientStudent", fields: [recipientStudentStubId], references: [id])
  recipientClassSectionId String?       @map("recipient_class_section_id") @db.Uuid
  recipientClassSection   ClassSection? @relation(fields: [recipientClassSectionId], references: [id])
  topicId                 String?       @map("topic_id") @db.Uuid
  topic                   Topic?        @relation(fields: [topicId], references: [id])
  body                    String
  deliveryMechanism       String?       @map("delivery_mechanism")
  deliveryStatus          String        @default("sent") @map("delivery_status")
  sentAt                  DateTime?     @map("sent_at")
  createdAt               DateTime      @default(now()) @map("created_at")

  @@index([schoolId, channel])
  @@index([recipientStudentStubId])
  @@index([senderStudentStubId])
  @@map("communication_message")
}

// Written on every AI generation call (lesson plan, research report,
// personalisation suggestion, grading) for cost tracking and the Admin
// Dashboard's AI Usage Analytics screen (FR-AI-4).
model AiUsageLog {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  school        School   @relation(fields: [schoolId], references: [id])
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  teacher       AppUser  @relation(fields: [teacherUserId], references: [id])
  feature       String
  model         String
  status        String   @default("success")
  durationMs    Int?     @map("duration_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  creditLedgerEntries CreditLedgerEntry[]

  @@index([schoolId, createdAt])
  @@index([schoolId, teacherUserId])
  @@map("ai_usage_log")
}

// Student login (phone + OTP, no password). Keyed by phone rather than by
// StudentStub because guardianContact can be shared by siblings - one OTP
// verifies the phone, then /auth/student/select picks which StudentStub to
// issue a token for. consumedAt prevents replaying a used code.
model StudentOtpRequest {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String
  otpCodeHash String    @map("otp_code_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("student_otp_request")
}

// Staff (AppUser) password reset - same shape/lifecycle as StudentOtpRequest,
// keyed by email instead of phone since staff sign in with email+password.
model PasswordResetRequest {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  otpCodeHash String    @map("otp_code_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_request")
}

// Minimal admin-action audit trail - who invited/disabled/changed-role/deleted
// what, and when. Not a full change-history system (no before/after diffing
// beyond a small metadata blob) - just enough to answer "who did this."
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String   @map("actor_email")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  targetLabel String?  @map("target_label")
  schoolId    String?  @map("school_id") @db.Uuid
  trustId     String?  @map("trust_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([trustId, createdAt])
  @@map("audit_log")
}

// AI Assistant Phase 1 - one rolling conversation per user (no thread list).
// See docs/superpowers/specs/2026-09-04-ai-assistant-phase1-design.md
model AiConversation {
  id        String      @id @default(uuid()) @db.Uuid
  // AppUser.id for staff, StudentStub.id for students (the JWT sub) - deliberately
  // no FK, since it points at one of two tables depending on role.
  userId    String      @map("user_id") @db.Uuid
  schoolId  String      @map("school_id") @db.Uuid
  school    School      @relation(fields: [schoolId], references: [id])
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  messages  AiMessage[]
  actions   AiAction[]

  @@unique([userId])
  @@map("ai_conversation")
}

// from is one of: user, assistant
model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  from           String
  text           String
  // Deep links the app renders as tappable chips under the bubble:
  // [{ label, screen, params }] - see backend/src/lib/assistant-tools.ts.
  links          Json?
  // Set on the message that carries a confirm card for a proposed write.
  actionId       String?        @unique @map("action_id") @db.Uuid
  action         AiAction?      @relation(fields: [actionId], references: [id])
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("ai_message")
}

// A write the assistant proposed. Never executed by the model itself - only
// by POST /ai-assistant/actions/:id/confirm, re-run as the user through the
// normal route (so role checks and validation are identical to the app's).
// status is one of: pending, confirmed, cancelled, failed.
model AiAction {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  tool           String
  args           Json
  summary        String
  status         String         @default("pending")
  resultText     String?        @map("result_text")
  resultLink     Json?          @map("result_link")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  message AiMessage?

  @@index([conversationId, status])
  @@map("ai_action")
}

// Individual-teacher onboarding + credits/billing
// (Docs/superpowers/plans/2026-09-09-individual-teacher-onboarding-and-credits.md)

// Billing plan a Trust is on - drives creditsPerTeacherSeat granted (once,
// not recurring) to each teacher seat under that trust. isDefault marks the
// platform-wide fallback plan used when a trust has none assigned (also what
// individual/self-signed-up teachers' personal trusts resolve to).
model Plan {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  creditsPerTeacherSeat Int      @map("credits_per_teacher_seat")
  // How many role="teacher" invites a trust on this plan may self-service
  // create (users.ts POST /users) before being blocked. Only enforced once
  // a Trust has planId explicitly set - a trust with no plan assigned is
  // grandfathered as unlimited, so this never retroactively breaks an
  // existing institutional customer on deploy. platform_admin always
  // bypasses this. See Docs/superpowers/plans/2026-09-09-individual-
  // teacher-onboarding-and-credits.md.
  teacherSeatLimit      Int      @default(5) @map("teacher_seat_limit")
  isDefault             Boolean  @default(false) @map("is_default")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  trusts Trust[]

  @@map("plan")
}

// Simple admin-editable key/value config. Seeded key
// "individual_default_credits" backstops Plan resolution when a trust (most
// commonly a fresh individual-teacher personal trust) has no Plan assigned.
model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_setting")
}

// Every AI feature that costs credits - the single source of truth for what
// a call is charged (lib/credits.ts getFeatureCost) AND for how it's named on
// the teacher's Credits screen, so the two can never disagree. key matches
// the `feature` string routes pass to logAiUsage() and that's stored as the
// ai_usage ledger entry's note. platform_admin edits these from the admin
// dashboard's Platform Settings. Rows are inserted by the migration that
// created this table, not by seed.ts, so every environment has them.
model AiFeature {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  label         String
  description   String
  // An Ionicons glyph name - rendered as-is by unified-app, which falls back
  // to a generic icon for a name it doesn't know.
  icon          String
  cost          Int
  // Listed under "Your balance covers" on the Credits screen. Off for
  // internal/legacy features a teacher can't directly start.
  showOnCredits Boolean  @default(false) @map("show_on_credits")
  sortOrder     Int      @default(0) @map("sort_order")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Uuid

  @@map("ai_feature")
}

// Platform-wide, platform_admin-editable long-form pages (Privacy Policy,
// Terms of Service, About) - not tenant-scoped, unlike everything else in
// this schema, because these describe EduWand itself, not a school's data.
// Served publicly with no auth (GET /content-pages/:key) so it can be linked
// from Google Play/App Store listings and read by logged-out users, and
// rendered from the same source in the admin-dashboard public pages, the
// mobile app's Legal screens, and eventually a marketing site - one place to
// edit, no app/dashboard rebuild needed to fix a typo or update a clause.
// key is one of: privacy_policy, terms_of_service, about, contact.
model ContentPage {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  title     String
  // Markdown source - rendered with react-markdown-display (app) / marked (web).
  bodyMarkdown String @map("body_markdown")
  // Structured data for a page that needs more than a wall of text to look
  // right - currently only "contact" ({ email, phone, whatsapp?, address,
  // hours? }), rendered as tappable icon cards instead of markdown on every
  // client. Null for every other key, which stays plain bodyMarkdown.
  fields    Json?
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("content_page")
}

// One row per teacher AppUser. Credits are a one-time grant (Plan resolution
// at seat-creation time), not a recurring refill - balance only moves via
// CreditLedgerEntry rows (ai_usage deductions, admin_topup credits).
model TeacherCreditAccount {
  id            String   @id @default(uuid()) @db.Uuid
  teacherUserId String   @unique @map("teacher_user_id") @db.Uuid
  teacher       AppUser  @relation(fields: [teacherUserId], references: [id])
  balance       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("teacher_credit_account")
}

// Audit trail of every credit balance change. reason is one of: plan_grant,
// admin_topup, ai_usage. relatedAiUsageLogId links an ai_usage deduction back
// to the AiUsageLog row that caused it; createdByUserId is set for
// admin_topup entries (who granted the top-up).
model CreditLedgerEntry {
  id                  String      @id @default(uuid()) @db.Uuid
  teacherUserId       String      @map("teacher_user_id") @db.Uuid
  teacher             AppUser     @relation(fields: [teacherUserId], references: [id])
  delta               Int
  reason              String
  balanceAfter        Int         @map("balance_after")
  relatedAiUsageLogId String?     @map("related_ai_usage_log_id") @db.Uuid
  relatedAiUsageLog   AiUsageLog? @relation(fields: [relatedAiUsageLogId], references: [id])
  note                String?
  createdByUserId     String?     @map("created_by_user_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")

  @@index([teacherUserId, createdAt])
  @@map("credit_ledger_entry")
}

// Individual-account subject limit (fixed set of exactly 2, not a running
// count cap - swapping which 2 counts as "a change"). status is one of:
// pending, approved, rejected. The 6-month cooldown is enforced by the route
// checking the requester's most recent APPROVED request's decidedAt, not by
// any field on this model. Institutional schools are never subject to this.
model SubjectChangeRequest {
  id                String    @id @default(uuid()) @db.Uuid
  teacherUserId     String    @map("teacher_user_id") @db.Uuid
  teacher           AppUser   @relation("SubjectChangeRequester", fields: [teacherUserId], references: [id])
  schoolId          String    @map("school_id") @db.Uuid
  school            School    @relation(fields: [schoolId], references: [id])
  currentSubjects   String[]  @map("current_subjects")
  requestedSubjects String[]  @map("requested_subjects")
  status            String    @default("pending")
  requestedAt       DateTime  @default(now()) @map("requested_at")
  decidedAt         DateTime? @map("decided_at")
  decidedByUserId   String?   @map("decided_by_user_id") @db.Uuid
  decidedBy         AppUser?  @relation("SubjectChangeDecider", fields: [decidedByUserId], references: [id])
  note              String?

  @@index([teacherUserId, decidedAt])
  @@map("subject_change_request")
}

// School.board is a request/approval-only setting for ALL schools (both
// individual and institutional) - there is no self-service board edit path
// anywhere. status is one of: pending, approved, rejected. Approval applies
// requestedBoard directly to School.board.
model BoardChangeTicket {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  school          School    @relation(fields: [schoolId], references: [id])
  currentBoard    String    @map("current_board")
  requestedBoard  String    @map("requested_board")
  status          String    @default("pending")
  raisedByUserId  String    @map("raised_by_user_id") @db.Uuid
  raisedBy        AppUser   @relation("BoardChangeRaiser", fields: [raisedByUserId], references: [id])
  decidedAt       DateTime? @map("decided_at")
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedBy       AppUser?  @relation("BoardChangeDecider", fields: [decidedByUserId], references: [id])
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@map("board_change_ticket")
}

// Classes are a fixed set too, same "request only" pattern as subjects -
// changeType is one of: add (one more class beyond the limit, nothing
// existing touched), replace (archive an existing class - isActive=false,
// all its data stays intact - and create a new one). status is one of:
// pending, approved, rejected. targetClassSectionId is only set for
// "replace". See Docs/superpowers/plans/2026-09-09-individual-teacher-
// onboarding-and-credits.md.
model ClassChangeRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  teacherUserId        String    @map("teacher_user_id") @db.Uuid
  teacher              AppUser   @relation("ClassChangeRequester", fields: [teacherUserId], references: [id])
  schoolId             String    @map("school_id") @db.Uuid
  school               School    @relation(fields: [schoolId], references: [id])
  changeType           String    @map("change_type")
  targetClassSectionId String?   @map("target_class_section_id") @db.Uuid
  requestedClassName   String    @map("requested_class_name")
  requestedSectionName String    @map("requested_section_name")
  status               String    @default("pending")
  requestedAt          DateTime  @default(now()) @map("requested_at")
  decidedAt            DateTime? @map("decided_at")
  decidedByUserId      String?   @map("decided_by_user_id") @db.Uuid
  decidedBy            AppUser?  @relation("ClassChangeDecider", fields: [decidedByUserId], references: [id])
  note                 String?

  @@index([teacherUserId, decidedAt])
  @@map("class_change_request")
}

// Submitted publicly (unauthenticated, via ClassSection.joinCode) by a
// student/parent - never direct entry, the teacher must approve before a
// real StudentStub is created. status is one of: pending, approved, rejected.
model ClassJoinRequest {
  id                   String       @id @default(uuid()) @db.Uuid
  classSectionId       String       @map("class_section_id") @db.Uuid
  classSection         ClassSection @relation(fields: [classSectionId], references: [id])
  studentName          String       @map("student_name")
  dateOfBirth          DateTime     @map("date_of_birth") @db.Date
  guardianName         String       @map("guardian_name")
  guardianContact      String       @map("guardian_contact")
  status               String       @default("pending")
  submittedAt          DateTime     @default(now()) @map("submitted_at")
  decidedAt            DateTime?    @map("decided_at")
  decidedByUserId      String?      @map("decided_by_user_id") @db.Uuid
  decidedBy            AppUser?     @relation("ClassJoinDecider", fields: [decidedByUserId], references: [id])
  createdStudentStubId String?      @map("created_student_stub_id") @db.Uuid
  note                 String?

  @@index([classSectionId, status])
  @@map("class_join_request")
}

// Teacher "getting started" checklist (mobile, teacher role only). One row
// per completed task per teacher - taskKey is one of a fixed set defined in
// backend/src/lib/onboarding.ts (first_class, first_lesson, first_assignment,
// first_student). Marked complete server-side from the relevant creation
// route, never client-reported, so it can't be faked and survives reinstalls.
model TeacherOnboardingTask {
  id            String   @id @default(uuid()) @db.Uuid
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  teacher       AppUser  @relation(fields: [teacherUserId], references: [id])
  taskKey       String   @map("task_key")
  completedAt   DateTime @default(now()) @map("completed_at")

  @@unique([teacherUserId, taskKey])
  @@map("teacher_onboarding_task")
}
